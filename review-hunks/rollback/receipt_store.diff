 def touch(receipt: RouteReceipt | Mapping[str, Any], *, now_ms: int | None = None, path: Path = DB_PATH) -> bool:
     """Say that the work behind an in-progress receipt is still going: refresh its ``updated_at_ms``, so it is not read as
     ``stale_incomplete``. A receipt that is closed, or was never begun, is left as it is (returns False)."""
     request_id = receipt.request_id if isinstance(receipt, RouteReceipt) else str(receipt.get("request_id") or "")
     timestamp = int(now_ms if now_ms is not None else time.time() * 1000)
     with _conn(path) as conn:
         conn.execute("BEGIN IMMEDIATE")
         row = conn.execute("SELECT receipt_json FROM receipts WHERE request_id=? AND status='in_progress'",
                            (request_id,)).fetchone()
         data = _safe_loads(row[0]) if row is not None else None
         if not isinstance(data, dict):
             return False
         data["updated_at_ms"] = timestamp
         conn.execute("UPDATE receipts SET receipt_json=? WHERE request_id=? AND status='in_progress'",
                      (json.dumps(data, ensure_ascii=False, sort_keys=True), request_id))
         conn.commit()
     return True
 
 
 def finalize(
     receipt: RouteReceipt | Mapping[str, Any],
     *,
     now_ms: int | None = None,
     path: Path = DB_PATH,
 ) -> bool:
     """CAS-terminalize one begun receipt; terminal duplicates are no-ops."""
     if isinstance(receipt, RouteReceipt):
         if receipt.status not in _TERMINAL_STATUSES:
             raise ValueError("finish receipt with a terminal status before finalizing")
         receipt.updated_at_ms = int(now_ms if now_ms is not None else time.time() * 1000)
