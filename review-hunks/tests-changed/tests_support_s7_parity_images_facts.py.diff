     return [r.get("body") for r in obs.trace["engine_requests"] if r["path"] == path]
 
 
+def prompt_bodies(obs: Obs) -> list[Any]:
+    """The prompts sent to the engine, without the adapter's push-session id (``client_id``): the old edit route sent none,
+    the row's adapter sends the id its event watcher uses (delta ``engine_session_id``)."""
+    def bare(body: Any) -> Any:
+        if isinstance(body, dict) and isinstance(body.get("text"), str):
+            try:
+                parsed = json.loads(body["text"])
+            except ValueError:
+                return body
+            if isinstance(parsed, dict):
+                parsed.pop("client_id", None)
+                return {**body, "text": json.dumps(parsed, sort_keys=True)}
+        return body
+    return [bare(body) for body in engine_bodies(obs, "/prompt")]
+
+
 def sleeps(obs: Obs) -> list[float]:
     """The gateway's waits that belong to the request. The receipt heartbeat of a handed-off job is infrastructure both
