# Install: copy to ~/.config/systemd/user/vram-observer.service, then `systemctl --user daemon-reload`
# and `systemctl --user enable --now vram-observer.service`. The gateway's exclusive pool for trellis
# (proxy_config.yml, backends.trellis.resource_capacity) reads GET /vram on 127.0.0.1:8891. If this unit is
# down, the trellis route answers 503 and its discovery row is unavailable; the gateway itself is unaffected.
[Unit]
Description=VRAM observer for the trellis exclusive route pool (GPU0 free and total memory, loopback only, port 8891)
After=network.target

[Service]
Type=simple
# Reads nvidia-smi only. It keeps no history and makes no admission decision. Stdlib only, so the gateway venv runs it.
ExecStart=%h/applications/azizam/venv/bin/python -m gateway.vram_observer --port 8891 --gpu 0
WorkingDirectory=%h/applications/azizam
Environment=PYTHONDONTWRITEBYTECODE=1
Nice=5
MemoryMax=256M
Restart=on-failure
RestartSec=10
LimitCORE=0

[Install]
WantedBy=default.target
