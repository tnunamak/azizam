# Install: copy to ~/.config/systemd/user/speech-to-speech.service, then `systemctl --user daemon-reload`.
# Do NOT enable it: the gateway starts it on the first /v1/realtime connection (lifecycle driver `systemd`).
# The software is Hugging Face speech-to-speech in a uv venv at ~/applications/speech-to-speech (pinned to a
# release tag; see run.sh there). It uses no GPU: CUDA is hidden and the installed torch is the CPU build.
[Unit]
Description=OpenAI Realtime server (Hugging Face speech-to-speech, CPU) - the gateway relays /v1/realtime here, port 8021
After=network.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=
Environment=HF_HOME=%h/.cache/huggingface
# One pipeline per concurrent session. They share the gateway's single LLM slot, so more than 2 only queues.
Environment=REALTIME_POOL_SIZE=2
Environment=REALTIME_PORT=8021
Nice=5
MemoryMax=6G
ExecStart=%h/applications/speech-to-speech/run.sh
Restart=on-failure
RestartSec=10
LimitCORE=0

[Install]
WantedBy=default.target
