# Install: create ~/.config/azizam/decider-quality.env with one line, DECIDER_MODEL=/path/to/model.gguf (the model file),
# copy this file to ~/.config/systemd/user/decider-quality.service, then `systemctl --user daemon-reload`.
# The unit does not start without that file.
# Do NOT enable it. The gateway starts it only for decide-quality.
[Unit]
Description=Decision engine (decider-4b v2.1 Q4_K_M, placement-configured), port 8025
After=network.target

[Service]
Type=simple
Environment=LLAMA_SERVER=%h/applications/llamacpp-official-b11337-fa-all-quants/bin/llama-server
# This file sets DECIDER_MODEL to the operator's model file.
EnvironmentFile=%h/.config/azizam/decider-quality.env
Environment=DECIDER_MODEL_ID=decider-4b-v2.1
Environment=DECIDER_PLACEMENT=cpu
Environment=DECIDER_RESIDENCY=on_demand
Environment=DECIDER_PORT=8025
Environment=DECIDER_LLAMA_PORT=8026
Environment=DECIDER_THREADS=8
Environment=DECIDER_CTX=4096
Environment=DECIDER_IDLE_EXIT_S=600
Environment=DECIDER_PYTHON=%h/applications/azizam/venv/bin/python
ExecStart=%h/applications/azizam/scripts/decider-idle-exit.sh
Restart=on-failure
RestartSec=10
MemoryMax=10G
LimitCORE=0

[Install]
WantedBy=default.target
