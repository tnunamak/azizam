{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "format": "prettier --write .",
    "doctor": "react-doctor --no-telemetry --blocking error",
    "check": "tsc --noEmit && next lint && npm run doctor && next build",
    "test": "npm run test:components",
    "test:e2e": "playwright test --config playwright.config.ts && playwright test --config playwright.live-data.config.ts",
    "test:components": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test --config playwright.legacy.config.ts",
    "test:all": "npm run test:components && npm run test:browser",
    "visual:capture": "darshana",
    "sweep": "node e2e/sweep/run.mjs",
    "sweep:live": "node e2e/sweep/run.mjs --live",
    "sweep:report": "node e2e/sweep/report.mjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.51.0",
    "next": "15.5.19",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "^3",
    "@opendatalabs/darshana": "1.4.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "jest-axe": "10.0.0",
    "jsdom": "26.1.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-doctor": "^0.5.1",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@opendatalabs/darshana@1.4.0": false,
    "esbuild@0.28.2": true
  }
}
