{
 "definitions": {
  "format_version": 1,
  "definitions": [
   {
    "definition": "openai-compatible",
    "definition_version": 1,
    "title": "Any OpenAI-compatible server",
    "example": "For example, vLLM, llama.cpp or LM Studio",
    "summary": "Chat and embeddings. Azizam finds out which of these the server offers.",
    "badge": "Most servers",
    "keywords": [
     "openai",
     "compatible",
     "vllm",
     "llama.cpp",
     "lm studio",
     "localai",
     "tabby",
     "text generation",
     "api",
     "v1",
     "jan",
     "sglang",
     "llamafile",
     "kobold"
    ],
    "flow": "detect",
    "steps": [
     "Kind",
     "Address and key",
     "What it can do",
     "Models",
     "Name"
    ],
    "fields": [
     {
      "key": "address",
      "label": "Address",
      "type": "url",
      "required": true,
      "order": 1,
      "placeholder": "http://192.168.1.50:8080/v1",
      "help": "Where the server listens, with its port. Usually ends in /v1."
     },
     {
      "key": "api_key",
      "label": "API key",
      "type": "secret",
      "secret": true,
      "writeOnly": true,
      "order": 2,
      "placeholder": "Optional",
      "help": "Leave empty if the server has no key."
     },
     {
      "key": "api_key_env",
      "label": "Environment variable name",
      "type": "text",
      "order": 3,
      "placeholder": "LAN_SERVER_KEY",
      "secondary_of": "api_key",
      "help": "Azizam reads the key from this variable on the gateway’s computer. Only the name is saved. The value is never shown."
     },
     {
      "key": "headers",
      "label": "Request headers",
      "type": "keyvalue",
      "advanced": true,
      "group": "Request headers",
      "order": 10,
      "default": [],
      "help": "Extra headers Azizam sends with every chat and embedding request to this server, for example X-Client: azizam-home. They are saved as plain text, so don’t put a key here."
     },
     {
      "key": "reply_timeout_s",
      "label": "Time to wait for a reply",
      "type": "duration",
      "advanced": true,
      "group": "Timeouts",
      "order": 21,
      "default": 600,
      "unit": "seconds",
      "help": "How long Azizam waits for an answer before it gives up. The default, 10 minutes, is the gateway’s own limit."
     },
     {
      "key": "path_prefix",
      "label": "Extra path before every request",
      "type": "text",
      "advanced": true,
      "group": "Extra path",
      "order": 30,
      "default": "",
      "placeholder": "Empty",
      "help": "Leave empty unless the server needs one, for example /openai. Azizam puts it between the address and each route."
     },
     {
      "key": "transforms",
      "label": "Request adjustments",
      "type": "list",
      "items": "transform",
      "advanced": true,
      "group": "Request adjustments",
      "order": 40,
      "default": [
       "reasoning-effort-final-chat"
      ],
      "help": "Fix a mismatch between what apps send and what this server accepts, for example leave out a field the server refuses. Each one says in plain words what it does."
     },
     {
      "key": "lifecycle_mode",
      "label": "Who starts and stops this server",
      "type": "select",
      "advanced": true,
      "owner_only": true,
      "group": "Start and stop",
      "order": 50,
      "default": "external",
      "options": [
       {
        "value": "external",
        "label": "Azizam leaves it running (default)"
       },
       {
        "value": "managed",
        "label": "Azizam starts and stops it"
       }
      ]
     },
     {
      "key": "lifecycle_start",
      "label": "Start command",
      "type": "text",
      "advanced": true,
      "owner_only": true,
      "group": "Start and stop",
      "order": 51,
      "show_if": {
       "field": "lifecycle_mode",
       "equals": "managed"
      },
      "help": "Run on the gateway’s computer when a request needs this server."
     },
     {
      "key": "lifecycle_stop",
      "label": "Stop command",
      "type": "text",
      "advanced": true,
      "owner_only": true,
      "group": "Start and stop",
      "order": 52,
      "show_if": {
       "field": "lifecycle_mode",
       "equals": "managed"
      }
     },
     {
      "key": "lifecycle_ready_s",
      "label": "Wait for it to be ready",
      "type": "duration",
      "advanced": true,
      "owner_only": true,
      "group": "Start and stop",
      "order": 53,
      "default": 120,
      "unit": "seconds",
      "show_if": {
       "field": "lifecycle_mode",
       "equals": "managed"
      }
     },
     {
      "key": "models",
      "label": "Models",
      "type": "multiselect",
      "order": 60,
      "options_from": "models",
      "custom_value": true
     },
     {
      "key": "context_window",
      "label": "Context window",
      "type": "number",
      "order": 61,
      "unit": "tokens",
      "default_from": "models.context_window"
     }
    ],
    "check_rows": [
