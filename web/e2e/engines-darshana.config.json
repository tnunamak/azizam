{
  "title": "Engines detect and apply review",
  "url": "http://127.0.0.1:18580/ui/",
  "start": "/home/",
  "crawl": {
    "include": ["^/ui/(home|engines|services)/"],
    "extraRoutes": ["/engines/", "/services/"],
    "maxDepth": 2,
    "maxPages": 4
  },
  "capture": {
    "themes": ["light", "dark"],
    "viewports": ["desktop", "mobile"],
    "delay": 1000
  },
  "outputs": ["html", "images"]
}
