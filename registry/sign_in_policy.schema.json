{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizam.local/schemas/sign_in_policy.schema.json",
  "title": "Sign-in policy",
  "description": "The provider-config omission defaults, the admin-session cookie defaults, and the lifetimes and bounds of a sign-in attempt. Closed: no secret, issuer, client id or address may appear here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "session_cookie",
    "pending_login",
    "auth_time_clock_skew_seconds",
    "jwks",
    "connection_attempt_seconds"
  ],
  "properties": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "scopes",
        "groups_claim",
        "clock_skew_seconds",
        "display_name_max_chars"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scopes": {
          "description": "OIDC requires the openid scope.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\S+$"
          },
          "contains": {
            "const": "openid"
          },
          "uniqueItems": true
        },
        "groups_claim": {
          "type": "string",
          "minLength": 1
        },
        "clock_skew_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "display_name_max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "session_cookie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "max_age_seconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "pending_login": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "max_pending"
      ],
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_pending": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "auth_time_clock_skew_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "jwks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttl_seconds",
        "refresh_interval_seconds"
      ],
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "refresh_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "connection_attempt_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  }
}
