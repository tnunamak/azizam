{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "azizam/protocol-description/1",
  "title": "Protocol description (http-v1 grammar, version 1)",
  "description": "A protocol description is data: how Azizam talks to a kind of engine. Closed schema: unknown keys are refused. Pointers, rules and budgets are checked by gateway/engine_protocol/description.py when the file loads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "id",
    "executor",
    "operations"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "executor": {
      "type": "string",
      "pattern": "^(http-v1|adapter:[a-z][a-z0-9-]{0,63})$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "How messages name this engine to the caller. An adapter executor reads it, so no module spells an engine name."
    },
    "serves": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      },
      "description": "Capability tokens an engine record carries. An adapter executor uses them to answer for a record that names no protocol."
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inference": {
          "$ref": "#/$defs/auth"
        },
        "control": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/advice"
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "pointer": {
      "type": "string",
      "maxLength": 256
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "bearer",
            "header",
            "query",
            "none"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "scheme": {
          "type": "string",
          "pattern": "^[A-Za-z]{0,32}$"
        }
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code",
        "advice"
      ],
      "properties": {
        "status": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "advice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "inventory",
            "generate",
            "control"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "response": {
          "$ref": "#/$defs/response"
        },
        "job": {
          "$ref": "#/$defs/job"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "query": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "from"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "from": {
                "$ref": "#/$defs/pointer"
              },
              "default": {
                "$ref": "#/$defs/scalar"
              }
            }
          }
        },
        "headers": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "enum": [
                "none",
                "json",
                "multipart"
              ]
            },
            "base": {
              "enum": [
                "empty",
                "passthrough"
              ]
            },
            "map": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mappingRule"
              }
            },
            "parts": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/part"
              }
            }
          }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "from"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "kind": {
          "enum": [
            "field",
            "json",
            "file"
          ]
        },
        "from": {
          "$ref": "#/$defs/pointer"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/scalar"
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/pointer"
        },
        "present": {
          "type": "boolean"
        },
        "equals": {
          "$ref": "#/$defs/scalar"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sentinel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "path": {
          "$ref": "#/$defs/pointer"
        },
        "equals": {
          "$ref": "#/$defs/scalar"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framing": {
          "enum": [
            "json",
            "sse",
            "ndjson",
            "binary",
            "none"
          ]
        },
        "select": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "$ref": "#/$defs/pointer"
          }
        },
        "map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingRule"
          }
        },
        "terminal": {
          "$ref": "#/$defs/terminal"
        },
        "stream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when",
            "framing"
          ],
          "properties": {
            "when": {
              "$ref": "#/$defs/predicate"
            },
            "framing": {
              "enum": [
                "sse",
                "ndjson"
              ]
            },
            "terminal": {
              "$ref": "#/$defs/terminal"
            },
            "map": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mappingRule"
              }
            },
            "base": {
              "enum": [
                "empty",
                "passthrough"
              ]
            }
          }
        },
        "base": {
          "enum": [
            "empty",
            "passthrough"
          ]
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submit",
        "poll"
      ],
      "properties": {
        "submit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "id"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            },
            "id": {
              "$ref": "#/$defs/pointer"
            }
          }
        },
        "poll": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "status",
            "interval_s",
            "max_wait_s"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            },
            "status": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "states"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/pointer"
                },
                "states": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 32,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "error": {
              "$ref": "#/$defs/pointer"
            },
            "assets": {
              "$ref": "#/$defs/pointer"
            },
            "interval_s": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 300
            },
            "max_wait_s": {
              "type": "number",
              "minimum": 1,
              "maximum": 86400
            }
          }
        },
        "fetch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            }
          }
        },
        "cancel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            }
          }
        }
      }
    },
    "mappingRule": {
      "type": "object",
      "description": "Rules are validated by the mapping compiler. each maps an array to fresh objects with lexical /item and /index roots; max_rules, combined max_when_depth, cumulative max_selected, mapping_s, max_json_depth and request/response byte budgets apply.",
      "if": {
        "required": [
          "each"
        ]
      },
      "then": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "each"
        ],
        "properties": {
          "each": {
            "$ref": "#/$defs/each"
          }
        }
      }
    },
    "each": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "map"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/pointer"
        },
        "to": {
          "$ref": "#/$defs/pointer"
        },
        "map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingRule"
          }
        }
      }
    }
  }
}
