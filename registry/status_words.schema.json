{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizam.local/schemas/status_words.schema.json",
  "title": "Status words",
  "description": "What the status page and the metrics sampler call the services of a capability role. Closed: every word is required and none may be added without a reader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status_words"
  ],
  "properties": {
    "status_words": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "images",
        "chat",
        "audio.speech"
      ],
      "properties": {
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "short_label",
            "backend_names",
            "queue_key",
            "custom_nodes_key",
            "view_key",
            "ws_state_key",
            "version_key",
            "stats_error_key",
            "gpu_budget_key",
            "gpu_budget_var",
            "output_root_key",
            "output_video_key",
            "queue_running_series",
            "queue_pending_series",
            "dir_env",
            "output_dir_env",
            "custom_nodes_env",
            "baseline_field",
            "audio_decode_class",
            "two_stage_class",
            "client_id_attr"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "short_label": {
              "type": "string",
              "minLength": 1
            },
            "backend_names": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "queue_key": {
              "type": "string",
              "minLength": 1
            },
            "custom_nodes_key": {
              "type": "string",
              "minLength": 1
            },
            "view_key": {
              "type": "string",
              "minLength": 1
            },
            "ws_state_key": {
              "type": "string",
              "minLength": 1
            },
            "version_key": {
              "type": "string",
              "minLength": 1
            },
            "stats_error_key": {
              "type": "string",
              "minLength": 1
            },
            "gpu_budget_key": {
              "type": "string",
              "minLength": 1
            },
            "gpu_budget_var": {
              "type": "string",
              "minLength": 1
            },
            "output_root_key": {
              "type": "string",
              "minLength": 1
            },
            "output_video_key": {
              "type": "string",
              "minLength": 1
            },
            "queue_running_series": {
              "type": "string",
              "minLength": 1
            },
            "queue_pending_series": {
              "type": "string",
              "minLength": 1
            },
            "dir_env": {
              "type": "string",
              "minLength": 1
            },
            "output_dir_env": {
              "type": "string",
              "minLength": 1
            },
            "custom_nodes_env": {
              "type": "string",
              "minLength": 1
            },
            "baseline_field": {
              "type": "string",
              "minLength": 1
            },
            "audio_decode_class": {
              "type": "string",
              "minLength": 1
            },
            "two_stage_class": {
              "type": "string",
              "minLength": 1
            },
            "client_id_attr": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "chat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "card_name",
            "props_section",
            "crash_event",
            "crash_title",
            "slots_active_series",
            "slots_total_series",
            "tensor_split_note",
            "aux_path_key",
            "aux_path_label"
          ],
          "properties": {
            "card_name": {
              "type": "string",
              "minLength": 1
            },
            "props_section": {
              "type": "string",
              "minLength": 1
            },
            "crash_event": {
              "type": "string",
              "minLength": 1
            },
            "crash_title": {
              "type": "string",
              "minLength": 1
            },
            "slots_active_series": {
              "type": "string",
              "minLength": 1
            },
            "slots_total_series": {
              "type": "string",
              "minLength": 1
            },
            "tensor_split_note": {
              "type": "string",
              "minLength": 1
            },
            "aux_path_key": {
              "type": "string",
              "minLength": 1
            },
            "aux_path_label": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "audio.speech": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit_candidates",
            "exec_labels",
            "native_voice_source",
            "example_model"
          ],
          "properties": {
            "unit_candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "\\.service$"
              }
            },
            "exec_labels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contains",
                  "label"
                ],
                "properties": {
                  "contains": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^A-Z]+$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "native_voice_source": {
              "type": "string",
              "minLength": 1
            },
            "example_model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
