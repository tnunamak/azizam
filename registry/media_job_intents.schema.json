{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "azizam://registry/media_job_intents",
  "title": "media job intents",
  "description": "One row per media job intent. A submittable row names the sync route and request component; a row that is not submittable names neither. Intents are unique (checked by the loader).",
  "type": "object",
  "additionalProperties": false,
  "required": ["intents"],
  "properties": {
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent", "modality", "submittable"],
        "properties": {
          "intent": {"type": "string", "pattern": "^[a-z]+\\.[a-z]+$"},
          "modality": {"enum": ["image", "audio", "video"]},
          "submittable": {"type": "boolean"},
          "route": {"type": "string", "pattern": "^/v1/[a-z/]+$"},
          "component": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}
        },
        "if": {"properties": {"submittable": {"const": true}}},
        "then": {"required": ["route", "component"]},
        "else": {"not": {"anyOf": [{"required": ["route"]}, {"required": ["component"]}]}}
      }
    }
  }
}
