{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizam.local/schemas/video_grid.schema.json",
  "title": "Video grid defaults and stride reasons",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stride_reasons",
    "grid_defaults"
  ],
  "properties": {
    "stride_reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "by_step"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/reason"
        },
        "by_step": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[1-9][0-9]*$": {
              "$ref": "#/$defs/reason"
            }
          }
        }
      }
    },
    "grid_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length_step",
        "length_offset",
        "minimum_side",
        "size_when_unparsed"
      ],
      "properties": {
        "fallback_fps": {"type": "number", "exclusiveMinimum": 0},
        "fallback_size": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"},
        "fallback_size_multiple": {"type": "integer", "minimum": 1},
        "fallback_min_seconds": {"type": "number", "minimum": 0},
        "fallback_max_seconds": {"type": "number", "exclusiveMinimum": 0},
        "length_step": {
          "type": "integer",
          "minimum": 1
        },
        "length_offset": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_side": {
          "type": "integer",
          "minimum": 1
        },
        "size_when_unparsed": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "not": {
        "pattern": "[^a-z0-9_]"
      }
    }
  }
}
