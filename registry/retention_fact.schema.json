{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizam.local/schemas/retention_fact.schema.json",
  "title": "A dated fact about where request content can remain",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "holds", "where", "how_long", "default", "reach", "control", "evidence_url", "checked", "confidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "holds": {"type": "string", "minLength": 1, "maxLength": 500},
    "where": {"type": "string", "minLength": 1, "maxLength": 300},
    "how_long": {"type": "string", "minLength": 1, "maxLength": 500},
    "default": {"enum": ["on", "off", "conditional"]},
    "condition": {"type": ["string", "null"], "maxLength": 500},
    "reach": {"type": "string", "minLength": 1, "maxLength": 500},
    "control": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "checked": {"type": "string", "format": "date"},
    "confidence": {"enum": ["documented", "inferred", "unknown"]}
  }
}
