{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operations",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/spelling"
          },
          {
            "$ref": "#/$defs/binding"
          },
          {
            "$ref": "#/$defs/admission"
          },
          {
            "$ref": "#/$defs/runtime_policy"
          },
          {
            "$ref": "#/$defs/receipt"
          },
          {
            "$ref": "#/$defs/catalog_group"
          },
          {
            "$ref": "#/$defs/family"
          }
        ]
      }
    },
    "unexpressed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "key",
          "reason"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/text"
          },
          "key": {
            "$ref": "#/$defs/text"
          },
          "reason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "schema_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "request",
        "result",
        "submittable_as_job"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "family": {
          "$ref": "#/$defs/text"
        },
        "request": {
          "$ref": "#/$defs/schema_ref"
        },
        "result": {
          "$ref": "#/$defs/schema_ref"
        },
        "submittable_as_job": {
          "type": "boolean"
        },
        "modality": {
          "$ref": "#/$defs/text"
        },
        "media_type": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "spelling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "context",
        "word",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "spelling"
        },
        "context": {
          "enum": [
            "wire",
            "catalog",
            "legacy",
            "display"
          ]
        },
        "word": {
          "$ref": "#/$defs/text"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "method",
        "path",
        "representation",
        "modes"
      ],
      "properties": {
        "kind": {
          "const": "binding"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "representation": {
          "$ref": "#/$defs/text"
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "intent"
      ],
      "properties": {
        "kind": {
          "const": "admission"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "intent": {
          "$ref": "#/$defs/text"
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "policy"
      ],
      "properties": {
        "kind": {
          "const": "runtime_policy"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "policy": {
          "$ref": "#/$defs/text"
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "intent"
      ],
      "properties": {
        "kind": {
          "const": "receipt"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "intent": {
          "$ref": "#/$defs/text"
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "catalog_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "group",
        "operations"
      ],
      "properties": {
        "kind": {
          "const": "catalog_group"
        },
        "group": {
          "$ref": "#/$defs/text"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family"
      ],
      "properties": {
        "kind": {
          "const": "family"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "family": {
          "$ref": "#/$defs/text"
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "word": {
          "type": "string"
        },
        "context": {
          "enum": [
            "protocol",
            "route",
            "type"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "operation"
          ]
        },
        {
          "required": [
            "word"
          ]
        }
      ]
    }
  }
}
