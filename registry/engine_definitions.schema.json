{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizam.local/schemas/engine_definitions.schema.json",
  "title": "Azizam engine definitions",
  "description": "The data file Add engine reads. Each definition says which fields a kind of server needs, how Azizam checks it, what it can do and what to say when something fails. Detection rules name API shapes only. The gateway refuses a file outside this schema at load.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "capabilities", "evidence_text", "metadata_rows", "model_rules", "advice", "real_tests", "definitions"],
  "properties": {
    "$schema": {"type": "string"},
    "format_version": {"const": 1},
    "notes": {"type": "string"},
    "model_rules_note": {"type": "string"},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/capability"}
    },
    "evidence_text": {
      "type": "object",
      "required": ["possible", "possible_why", "against", "against_why", "none", "none_why", "needs_key", "likely_model_field", "likely_metadata", "likely_test"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "metadata_rows": {"type": "array", "items": {"$ref": "#/$defs/metadataRow"}},
    "model_rules": {"type": "array", "items": {"$ref": "#/$defs/modelRule"}},
    "context_window_keys": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "public_name_rules": {"type": "array", "items": {"$ref": "#/$defs/nameRule"}},
    "against_body": {"type": "string", "minLength": 1},
    "real_tests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/realTest"}},
    "advice": {"type": "array", "items": {"$ref": "#/$defs/advice"}},
    "definitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/definition"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {"enum": ["GET", "POST"]},
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "noun", "record_capabilities"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "noun": {"type": "string", "minLength": 1},
        "record_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "route": {"$ref": "#/$defs/route"},
        "real_test": {"type": "string"}
      }
    },
    "metadataRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "document", "method", "path", "from", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "document": {"type": "string"},
        "method": {"const": "GET"},
        "path": {"type": "string", "pattern": "^/"},
        "from": {"enum": ["origin", "address"]},
        "cap_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "kind": {"enum": ["openapi_paths", "capability_document", "model_list"]},
        "paths": {"type": "object", "additionalProperties": {"type": "string"}},
        "values": {"type": "object", "additionalProperties": {"type": "string"}},
        "require_json_key": {"type": "string"},
        "name_from": {"$ref": "#/$defs/nameFrom"}
      }
    },
    "nameFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json"],
      "properties": {
        "json": {"type": "string"},
        "ignore": {"type": "array", "items": {"type": "string"}},
        "extract": {"type": "string", "format": "regex"},
        "suffix": {"type": "string"}
      }
    },
    "modelRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "capability"],
      "oneOf": [{"required": ["equals"]}, {"required": ["contains"]}, {"required": ["matches"]}],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "equals": {"type": "string"},
        "contains": {"type": "string"},
        "matches": {"type": "string", "format": "regex"},
        "capability": {"$ref": "#/$defs/id"}
      }
    },
    "nameRule": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "strip": {"type": "string", "format": "regex"},
        "replace": {"type": "string", "format": "regex"},
        "with": {"type": "string"},
        "lower": {"type": "boolean"}
      }
    },
    "realTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sent", "cost"],
      "properties": {
        "sent": {"type": "string"},
        "cost": {"type": "string"},
        "body": {"type": "object"},
        "pass_json": {"type": "string"},
        "reply_json": {"type": "string"},
        "reply_count_json": {"type": "string"},
        "reply_count_text": {"type": "string"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Every key must hold for the row to apply. Rows are tried in order; the first one that applies wins.",
      "properties": {
        "transport": {"enum": ["ok", "refused", "dns", "timeout", "tls", "redirect", "blocked", "too_large"]},
        "transport_in": {"type": "array", "items": {"enum": ["refused", "dns", "timeout", "tls", "redirect", "blocked", "too_large"]}},
        "status": {"type": "integer"},
        "status_in": {"type": "array", "items": {"type": "integer"}},
        "status_class": {"type": "integer", "minimum": 1, "maximum": 5},
        "key_sent": {"type": "boolean"},
        "probe": {"type": "string"},
        "shape": {"enum": ["list", "not_list"]},
        "address_matches": {"type": "string", "format": "regex"},
        "body_matches": {"type": "string", "format": "regex"},
        "recognised": {"type": "boolean"},
        "models_count": {"type": "integer"},
        "duplicate": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"enum": ["fixpath", "openexisting"]},
        "label": {"type": "string"},
        "address_append": {"type": "string"},
        "address_strip": {"type": "string"}
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "field", "when", "title", "what", "why", "fix"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["error", "warning"]},
        "field": {"enum": ["address", "key"]},
        "when": {"$ref": "#/$defs/condition"},
        "title": {"type": "string", "minLength": 1},
        "what": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "why_everywhere": {"type": "string"},
        "fix": {"type": "string", "minLength": 1},
        "fix_admin": {"type": "string"},
        "summary_admin": {"type": "string"},
        "admin_note": {"type": "boolean"},
        "keep_off": {"type": "boolean"},
        "with_key": {"type": "boolean"},
        "raw_label": {"type": "string"},
        "action": {"$ref": "#/$defs/action"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 1},
        "help": {"type": "string"},
        "type": {"enum": ["text", "url", "secret", "number", "boolean", "select", "multiselect", "list", "keyvalue", "duration"]},
        "required": {"type": "boolean"},
        "default": {},
        "placeholder": {"type": "string"},
        "order": {"type": "integer"},
        "group": {"type": "string"},
        "secret": {"type": "boolean"},
        "writeOnly": {"type": "boolean"},
        "show_if": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "equals"],
          "properties": {"field": {"type": "string"}, "equals": {}}
        },
        "one_of": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discriminator", "options"],
          "properties": {"discriminator": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}}
        },
        "options": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["value", "label"], "properties": {"value": {"type": "string"}, "label": {"type": "string"}}}
        },
        "options_from": {"type": "string"},
        "custom_value": {"type": "boolean"},
        "default_from": {"type": "string"},
        "advanced": {"type": "boolean"},
        "owner_only": {"type": "boolean"},
        "secondary_of": {"type": "string"},
        "unit": {"enum": ["seconds", "tokens"]},
        "items": {"enum": ["transform", "text"]}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "secret"}}}, "then": {"required": ["secret", "writeOnly"], "properties": {"secret": {"const": true}, "writeOnly": {"const": true}}}},
        {"if": {"required": ["secret"], "properties": {"secret": {"const": true}}}, "then": {"required": ["writeOnly"], "properties": {"writeOnly": {"const": true}}}}
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "from", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "method": {"enum": ["GET", "POST"]},
        "path": {"type": "string", "pattern": "^/"},
        "from": {"enum": ["origin", "address"]},
        "kind": {"const": "model_list"},
        "list_keys": {"type": "array", "items": {"type": "string"}},
        "id_keys": {"type": "array", "items": {"type": "string"}},
        "require_json_key": {"type": "string"}
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Seconds for each probe, the whole check and the real-test reply cap. Omitted probe_s and real_test_s preserve 5 and 120 seconds. Omitted check_s preserves the caller's deadline without adding a new one.",
      "properties": {
        "probe_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 600, "default": 5},
        "check_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
        "real_test_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 600, "default": 120}
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "definition_version", "title", "summary", "flow", "steps", "fields", "probes", "capabilities", "default_ticked", "check_rows", "name_fallback", "advice", "record"],
      "properties": {
        "definition": {"$ref": "#/$defs/id"},
        "definition_version": {"type": "integer", "minimum": 1},
        "retention_facts": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
        "title": {"type": "string", "minLength": 1},
        "example": {"type": "string"},
        "summary": {"type": "string", "minLength": 1},
        "badge": {"type": "string"},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "flow": {"const": "detect"},
        "steps": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
        "timeouts": {"$ref": "#/$defs/timeouts"},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "metadata", "route_probes"],
          "properties": {
            "primary": {"$ref": "#/$defs/probe"},
            "metadata": {"type": "array", "items": {"$ref": "#/$defs/id"}},
            "route_probes": {"type": "boolean"},
            "route_base": {"type": "string", "pattern": "^/"}
          }
        },
        "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "default_ticked": {"const": "likely"},
        "check_rows": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "name_fallback": {"type": "string"},
        "models_note": {"type": "string"},
        "advice": {"type": "array", "items": {"$ref": "#/$defs/advice"}},
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "native_passthrough", "base_path"],
          "properties": {
            "protocol": {"type": "string"},
            "native_passthrough": {"type": "boolean"},
            "transforms": {"type": "array", "items": {"type": "string"}},
            "base_path": {"type": "string"}
          }
        }
      }
    }
  }
}
