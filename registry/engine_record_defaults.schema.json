{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizam.local/schemas/engine_record_defaults.schema.json",
  "title": "Engine record defaults",
  "description": "Values an engine's service record may leave out, by the capability a service is selected for. Closed: no address (host, port, base URL) may appear here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaults"
  ],
  "properties": {
    "defaults": {
      "type": "object",
      "description": "One bucket per capability a service is selected for, holding only the keys the gateway reads for it.",
      "additionalProperties": false,
      "properties": {
        "audio.speech": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_model": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            },
            "health_endpoint": {
              "type": "string",
              "pattern": "^/"
            },
            "status_panels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "output_key",
                  "title",
                  "short_title"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "health_json"
                    ]
                  },
                  "output_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "short_title": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "audio.transcriptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_model": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            },
            "health_endpoint": {
              "type": "string",
              "pattern": "^/"
            },
            "status_panels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "output_key",
                  "title",
                  "short_title"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "health_json"
                    ]
                  },
                  "output_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "short_title": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "embeddings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": {
              "type": "integer",
              "minimum": 1
            },
            "health_endpoint": {
              "type": "string",
              "pattern": "^/"
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": {
              "type": "integer",
              "minimum": 1
            },
            "default_model": {
              "type": "string",
              "minLength": 1
            },
            "workflows_dir": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "videos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "video_timeout": {
              "type": "integer",
              "minimum": 1
            },
            "video_workflows_dir": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_path",
            "scheme",
            "timeout",
            "headers",
            "models",
            "transforms",
            "role",
            "managed"
          ],
          "properties": {
            "base_path": {
              "type": "string"
            },
            "scheme": {
              "type": "string"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            },
            "headers": {
              "type": "array"
            },
            "models": {
              "type": "array"
            },
            "transforms": {
              "type": "array"
            },
            "role": {
              "type": "string"
            },
            "managed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "activation_file_constraints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/file_constraints"
      }
    }
  },
  "$defs": {
    "file_constraints": {
      "description": "Precedent: Ansible stat/assert file guards; driver_config.file_constraints uses this same shape.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "absolute": {
              "type": "boolean"
            },
            "exists": {
              "type": "boolean"
            },
            "suffixes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^\\."
              }
            }
          }
        },
        "aux": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "absolute": {
              "type": "boolean"
            },
            "exists": {
              "type": "boolean"
            },
            "suffixes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^\\."
              }
            }
          }
        }
      }
    },
    "inference_device": {
      "description": "Telegraf exec precedent: service-authored observation command, typed columns and explicit device selectors. A missing identity may use an explicitly declared legacy position.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stats_selector",
        "host_selector"
      ],
      "properties": {
        "stats_selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "value"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "string",
                "integer"
              ]
            },
            "fallback_position": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "host_selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "value"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "string",
                "integer"
              ]
            },
            "fallback_position": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "uuid_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "fields"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "type"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "str",
                      "int",
                      "optional_int",
                      "optional_float"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
