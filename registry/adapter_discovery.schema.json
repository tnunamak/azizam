    "max_age_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "header_age_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stale_list_s": {
      "type": "number",
      "exclusiveMinimum": 0
