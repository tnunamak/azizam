  "_meta": {
    "name": "video-ltx-2.5-long",
    "description": "LTX-2.5 22B distilled long-form chunked single-pass loop (ported from the LTX-2.3 RuneXX loop). Each chunk is a single-stage 8-step euler_ancestral pass (CFG 1) at full resolution; chunks are chained with latent guide frames plus an audio/video mask so video and audio stay continuous. Up to ~50 s. Optional first-frame image (image_node; strength 0 = text-only). Models: ltx-2.5-22b-distilled-transformer-comfy-int8-convrot, gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot, ltx-2.5-video-vae-bf16, ltx-2.5-audio-vae-bf16. Custom nodes: ComfyUI-LTXVideo, ComfyUI-KJNodes, ComfyUI-Easy-Use. License: LTX-2.x Community License.",
    "model_file": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
    "frame_rate": 24,
    "default_steps": 8,
    "max_seconds": 50,
    "default_size": "960x544",
    "prompt_node": "1621",
    "negative_prompt_node": "1626",
    "size_node": [
      "1606",
      "1591"
