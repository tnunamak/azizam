{
    "_meta": {
        "name": "qwen-image-2.1-edit-multiref",
        "description": "Multi-reference instruction edit via Qwen-Image 2.1, same stack as qwen-image-2.1-edit. TextEncodeQwenImage21 natively supports up to 16 reference images (io.Autogrow 'images' input); this workflow fixes the graph at 2 required reference slots (source_image + reference_image_2) because the gateway's static node-binding model (manifests.py _apply_mapping, flat node/input writes) cannot conditionally add/remove an Autogrow sub-key per request -- an optional 3rd slot would always be wired in, feeding a placeholder image as a real (if low-signal) reference on every request. A 3-image variant is a 10-line copy of this file (add LoadImage node '13' + 'image_3' key) once the gateway supports per-request Autogrow key pruning; flagging for phase5a. Both LoadImage nodes are declared in _meta.image_nodes so the gateway uploads references in order; the manifest also documents their source_image and reference_image_2 bindings.",
        "prompt_node": "6",
        "seed_node": "8",
        "image_nodes": [
            "4",
            "11"
        ],
        "background_removal": {
            "save_node": "10",
            "plain_image": [
                "9",
                0
            ],
            "transparent_image": [
                "99",
                0
            ],
            "rmbg_node": "99"
        }
    },
    "1": {
        "class_type": "UNETLoader",
        "inputs": {
            "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
            "weight_dtype": "default"
        }
    },
    "2": {
        "class_type": "CLIPLoader",
        "inputs": {
            "clip_name": "qwen3vl_8b_w4a8.safetensors",
            "type": "qwen_image",
            "device": "default"
        }
    },
    "3": {
        "class_type": "VAELoader",
        "inputs": {
            "vae_name": "texture_fix_vae_for_qwen_image_2.1_bf16.safetensors"
        }
    },
    "4": {
        "class_type": "LoadImage",
        "inputs": {
            "image": "input.png"
        }
    },
    "11": {
        "class_type": "LoadImage",
        "inputs": {
            "image": "input2.png"
        }
    },
    "5": {
        "class_type": "QwenImage21Cache",
        "inputs": {
            "model": [
                "1",
                0
            ],
            "device": "auto",
            "dtype": "default"
        }
    },
    "6": {
        "class_type": "JWString",
        "inputs": {
            "text": "combine the reference images"
        }
    },
    "7": {
        "class_type": "TextEncodeQwenImage21",
        "inputs": {
            "clip": [
                "2",
                0
            ],
            "prompt": [
                "6",
                0
            ],
            "negative_prompt": "",
            "resolution": 1024,
            "images": {
                "image_1": [
                    "4",
                    0
                ],
                "image_2": [
                    "11",
                    0
                ]
            },
            "vae": [
                "3",
                0
            ]
        }
    },
    "8": {
        "class_type": "KSampler",
        "inputs": {
            "model": [
                "5",
                0
            ],
            "seed": 0,
            "steps": 25,
            "cfg": 1.0,
            "sampler_name": "euler",
            "scheduler": "simple",
            "positive": [
                "7",
                0
            ],
            "negative": [
                "7",
                1
            ],
            "latent_image": [
                "7",
                2
            ],
            "denoise": 1.0
        }
    },
    "9": {
        "class_type": "VAEDecode",
        "inputs": {
            "samples": [
                "8",
                0
            ],
            "vae": [
                "3",
                0
            ]
        }
    },
    "10": {
        "class_type": "SaveImage",
        "inputs": {
            "images": [
                "9",
                0
            ],
            "filename_prefix": "qwen-image-2.1-edit-multiref"
        }
    },
    "99": {
        "class_type": "RMBG",
        "inputs": {
            "image": [
                "9",
                0
            ],
            "model": "RMBG-2.0",
            "sensitivity": 1.0,
            "process_res": 1024,
            "mask_blur": 2,
            "mask_offset": 0,
            "invert_output": false,
            "refine_foreground": true,
            "background": "Alpha",
            "background_color": "#00000000"
        }
    }
}
