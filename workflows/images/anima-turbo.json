{
    "_meta": {
        "name": "anima-turbo",
        "description": "Anima Turbo v1.1 (2B, Cosmos-Predict2 based, anime) local T2I workflow. Euler/simple, CFG 1.0, 10 steps; negative conditioning zeroed. Accepts booru tags plus prose.",
        "prompt_node": "4",
        "size_node": "6",
        "seed_node": "7",
        "batch_size_node": "6",
        "background_removal": {
            "save_node": "9",
            "plain_image": [
                "8",
                0
            ],
            "transparent_image": [
                "10",
                0
            ],
            "rmbg_node": "10"
        }
    },
    "1": {
        "class_type": "UNETLoader",
        "inputs": {
            "unet_name": "anima-turbo-v1.1.safetensors",
            "weight_dtype": "default"
        }
    },
    "2": {
        "class_type": "CLIPLoader",
        "inputs": {
            "clip_name": "qwen_3_06b_base.safetensors",
            "type": "stable_diffusion",
            "device": "default"
        }
    },
    "3": {
        "class_type": "VAELoader",
        "inputs": {
            "vae_name": "qwen_image_vae.safetensors"
        }
    },
    "4": {
        "class_type": "CLIPTextEncode",
        "inputs": {
            "text": "a placeholder prompt",
            "clip": [
                "2",
                0
            ]
        }
    },
    "5": {
        "class_type": "ConditioningZeroOut",
        "inputs": {
            "conditioning": [
                "4",
                0
            ]
        }
    },
    "6": {
        "class_type": "EmptyLatentImage",
        "inputs": {
            "width": 1024,
            "height": 1024,
            "batch_size": 1
        }
    },
    "7": {
        "class_type": "KSampler",
        "inputs": {
            "model": [
                "1",
                0
            ],
            "seed": 0,
            "steps": 10,
            "cfg": 1.0,
            "sampler_name": "euler",
            "scheduler": "simple",
            "positive": [
                "4",
                0
            ],
            "negative": [
                "5",
                0
            ],
            "latent_image": [
                "6",
                0
            ],
            "denoise": 1.0
        }
    },
    "8": {
        "class_type": "VAEDecode",
        "inputs": {
            "samples": [
                "7",
                0
            ],
            "vae": [
                "3",
                0
            ]
        }
    },
    "9": {
        "class_type": "SaveImage",
        "inputs": {
            "images": [
                "8",
                0
            ],
            "filename_prefix": "anima-turbo"
        }
    },
    "10": {
        "class_type": "RMBG",
        "inputs": {
            "image": [
                "8",
                0
            ],
            "model": "RMBG-2.0",
            "sensitivity": 1.0,
            "process_res": 1024,
            "mask_blur": 2,
            "mask_offset": 0,
            "invert_output": false,
            "refine_foreground": true,
            "background": "Alpha",
            "background_color": "#00000000"
        }
    }
}
