{
    "_meta": {
        "name": "ideogram4-nvfp4-split",
        "description": "Ideogram 4 nvfp4 — r/SD-tuned: ModelSamplingAuraFlow shift=5 (quality), split-sigmas two-stage sampler (early-step refusal-basin bypass), DualModelGuider + two-phase CFGOverride (1.0 -> 3.5). JSON prompts recommended.",
        "prompt_node": "6",
        "size_node": ["27", "40"],
        "seed_node": "18",
        "background_removal": {
            "save_node": "9",
            "plain_image": ["8", 0],
            "transparent_image": ["90", 0],
            "rmbg_node": "90"
        }
    },
    "1": {
        "class_type": "UNETLoader",
        "inputs": {
            "unet_name": "ideogram4_nvfp4_mixed.safetensors",
            "weight_dtype": "default"
        }
    },
    "2": {
        "class_type": "UNETLoader",
        "inputs": {
            "unet_name": "ideogram4_unconditional_nvfp4_mixed.safetensors",
            "weight_dtype": "default"
        }
    },
    "3": {
        "class_type": "CLIPLoader",
        "inputs": {
            "clip_name": "qwen3vl_8b_fp8_scaled.safetensors",
            "type": "ideogram4"
        }
    },
    "4": {
        "class_type": "VAELoader",
        "inputs": {
            "vae_name": "flux2-vae.safetensors"
        }
    },
    "6": {
        "class_type": "CLIPTextEncode",
        "inputs": {
            "text": "a beautiful landscape",
            "clip": ["3", 0]
        }
    },
    "27": {
        "class_type": "EmptySD3LatentImage",
        "inputs": {
            "width": 1024,
            "height": 1024,
            "batch_size": 1
        }
    },
    "18": {
        "class_type": "RandomNoise",
        "inputs": {
            "noise_seed": 0
        }
    },
    "40": {
        "class_type": "Ideogram4Scheduler",
        "inputs": {
            "steps": 20,
            "width": 1024,
            "height": 1024,
            "mu": 0.0,
            "std": 1.75
        }
    },
    "41": {
        "class_type": "KSamplerSelect",
        "inputs": {
            "sampler_name": "euler"
        }
    },
    "60": {
        "class_type": "ModelSamplingAuraFlow",
        "inputs": {
            "model": ["1", 0],
            "shift": 5.0
        }
    },
    "44": {
        "class_type": "CFGOverride",
        "inputs": {
            "model": ["60", 0],
            "cfg": 1.0,
            "start_percent": 0.0,
            "end_percent": 0.7
        }
    },
    "45": {
        "class_type": "CFGOverride",
        "inputs": {
            "model": ["44", 0],
            "cfg": 3.5,
            "start_percent": 0.7,
            "end_percent": 1.0
        }
    },
    "42": {
        "class_type": "DualModelGuider",
        "inputs": {
            "model": ["45", 0],
            "model_negative": ["2", 0],
            "positive": ["6", 0],
            "cfg": 1.0
        }
    },
    "50": {
        "class_type": "ExtendIntermediateSigmas",
        "inputs": {
            "sigmas": ["40", 0],
            "steps": 2,
            "start_at_sigma": -1.0,
            "end_at_sigma": 12.0,
            "spacing": "linear"
        }
    },
    "51": {
        "class_type": "SplitSigmas",
        "inputs": {
            "sigmas": ["50", 0],
            "step": 4
        }
    },
    "53": {
        "class_type": "DisableNoise",
        "inputs": {}
    },
    "43": {
        "class_type": "SamplerCustomAdvanced",
        "inputs": {
            "noise": ["18", 0],
            "guider": ["42", 0],
            "sampler": ["41", 0],
            "sigmas": ["51", 0],
            "latent_image": ["27", 0]
        }
    },
    "52": {
        "class_type": "SamplerCustomAdvanced",
        "inputs": {
            "noise": ["53", 0],
            "guider": ["42", 0],
            "sampler": ["41", 0],
            "sigmas": ["51", 1],
            "latent_image": ["43", 0]
        }
    },
    "8": {
        "class_type": "VAEDecode",
        "inputs": {
            "samples": ["52", 0],
            "vae": ["4", 0]
        }
    },
    "9": {
        "class_type": "SaveImage",
        "inputs": {
            "filename_prefix": "api",
            "images": ["8", 0]
        }
    },
    "90": {
        "class_type": "RMBG",
        "inputs": {
            "image": ["8", 0],
            "model": "RMBG-2.0",
            "sensitivity": 1.0,
            "process_res": 1024,
            "mask_blur": 2,
            "mask_offset": 0,
            "invert_output": false,
            "refine_foreground": true,
            "background": "Alpha",
            "background_color": "#00000000"
        }
    }
}
