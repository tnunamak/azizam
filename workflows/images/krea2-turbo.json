{
  "_meta": {
    "name": "krea2-turbo",
    "description": "Krea 2 Turbo (int8_convrot) local T2I workflow. Euler/simple, CFG 1.0 (turbo is CFG-distilled), 8 steps per community consensus (research-image.md). Negative conditioning is zeroed (no true CFG pass) which is the standard turbo-model pattern and ~2x faster than a real negative pass.",
    "prompt_node": "4",
    "size_node": "6",
    "seed_node": "7",
    "batch_size_node": "6"
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "krea2_turbo_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "krea2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a placeholder prompt",
      "clip": ["2", 0]
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["4", 0]
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "krea2-turbo"
    }
  }
}
