{
  "_meta": {
    "name": "ace-step-1.5-2b-base",
    "description": "ACE-Step 1.5 Turbo AIO text-to-music via native ComfyUI nodes",
    "prompt_node": [{"node": "5", "key": "tags"}],
    "duration_node": [
      {"node": "10", "key": "seconds"},
      {"node": "5", "key": "duration"}
    ],
    "seed_node": "20",
    "save_node": "38"
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ace_step_1.5_turbo_aio.safetensors"
    }
  },
  "5": {
    "class_type": "TextEncodeAceStepAudio1.5",
    "inputs": {
      "clip": ["1", 1],
      "tags": "a beautiful piano piece",
      "lyrics": "[instrumental]",
      "seed": 0,
      "bpm": 90,
      "duration": 30.0,
      "timesignature": "4",
      "language": "en",
      "keyscale": "C major",
      "generate_audio_codes": true,
      "cfg_scale": 2.0,
      "temperature": 0.85,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0.0
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["5", 0]
    }
  },
  "10": {
    "class_type": "EmptyAceStep1.5LatentAudio",
    "inputs": {
      "seconds": 30.0,
      "batch_size": 1
    }
  },
  "15": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": ["1", 0],
      "shift": 3.0
    }
  },
  "20": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["15", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["10", 0],
      "seed": 0,
      "steps": 50,
      "cfg": 2.0,
      "sampler_name": "er_sde",
      "scheduler": "linear_quadratic",
      "denoise": 1.0
    }
  },
  "30": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["20", 0],
      "vae": ["1", 2]
    }
  },
  "38": {
    "class_type": "SaveAudio",
    "inputs": {
      "filename_prefix": "ace-step/music",
      "audio": ["30", 0]
    }
  }
}
