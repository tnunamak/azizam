{
 "_meta": {
  "name": "sfx-stable-audio-3-small",
  "description": "Stable Audio 3 small-sfx text-to-sound-effect (stereo 44.1k). License stable-audio-community. Uses non-tiled VAEDecodeAudio: VAEDecodeAudioTiled fails with a tensor size mismatch on short durations (4 s).",
  "model_file": "stable_audio_3_small_sfx.safetensors",
  "prompt_node": "3",
  "duration_node": [
   {
    "node": "5",
    "key": "seconds"
   }
  ],
  "seed_node": "6",
  "save_node": "8"
 },
 "1": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "stable_audio_3_small_sfx.safetensors"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "t5gemma_b_b_ul2.safetensors",
   "type": "stable_audio",
   "device": "default"
  }
 },
 "3": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "heavy rain falling on a tin roof with distant rolling thunder"
  }
 },
 "4": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": ""
  }
 },
 "5": {
  "class_type": "EmptyLatentAudio",
  "inputs": {
   "seconds": 10.0,
   "batch_size": 1
  }
 },
 "6": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "seed": 1,
   "steps": 8,
   "cfg": 1.0,
   "sampler_name": "lcm",
   "scheduler": "simple",
   "positive": [
    "3",
    0
   ],
   "negative": [
    "4",
    0
   ],
   "latent_image": [
    "5",
    0
   ],
   "denoise": 1.0
  }
 },
 "7": {
  "class_type": "VAEDecodeAudio",
  "inputs": {
   "samples": [
    "6",
    0
   ],
   "vae": [
    "1",
    2
   ]
  }
 },
 "8": {
  "class_type": "SaveAudio",
  "inputs": {
   "audio": [
    "7",
    0
   ],
   "filename_prefix": "audio/sa3-sfx"
  }
 }
}
