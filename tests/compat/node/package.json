    "probe:ai-sdk": "node --test vercel-ai-sdk.test.mjs"
  },
  "devDependencies": {
    "openai": "^4.60.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "ollama": "^0.5.0",
    "ai": "^3.4.0",
    "@ai-sdk/openai": "^0.0.70"
  }
}
