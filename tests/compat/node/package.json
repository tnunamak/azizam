{
  "name": "openai-proxy-compat-node",
  "private": true,
  "version": "0.0.0",
  "description": "Node-side SDK compatibility probes (OpenAI, Anthropic, Ollama, Vercel AI SDK). Not installed by the core Python repo — see tests/compat/node/README.md.",
  "type": "module",
  "scripts": {
    "probe:all": "node --test *.test.mjs",
    "probe:openai": "node --test openai.test.mjs",
    "probe:anthropic": "node --test anthropic.test.mjs",
    "probe:ollama": "node --test ollama.test.mjs",
    "probe:ai-sdk": "node --test vercel-ai-sdk.test.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.66",
    "@anthropic-ai/sdk": "^0.100.0",
    "ai": "^6.0.192",
    "ollama": "^0.6.3",
    "openai": "^6.39.1"
  }
}
