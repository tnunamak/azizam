{
  "name": "openai-proxy-compat-node",
  "private": true,
  "version": "0.0.0",
  "description": "Node-side SDK compatibility probes (OpenAI, Anthropic, Ollama, Vercel AI SDK). Not installed by the core Python repo — see tests/compat/node/README.md.",
  "type": "module",
  "scripts": {
    "probe:openai": "node --test openai.test.mjs",
