{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai-proxy/compat/long_tail_targets.schema.json",
  "title": "Long-tail Compatibility Target Matrix",
  "description": "Curated, machine-readable list of self-hosted clients and agent frameworks the gateway should remain compatible with. Each row describes how to point the client at the gateway and which gateway endpoints it exercises, so a future worker can lift it into an automated probe.",
  "type": "object",
  "required": ["version", "generated_at", "targets"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema-version label for this document, independent of any individual row."
    },
    "generated_at": {
      "type": "string",
      "format": "date",
      "description": "ISO date this snapshot was authored. Rows themselves are not dated; bump this when the file is meaningfully revised."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "deployment",
        "protocols",
        "client_config",
        "endpoints",
        "smoke_cases",
        "priority",
        "status",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable kebab-case identifier. Used as a join key in matrix output."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable product or framework name."
        },
        "category": {
          "type": "string",
          "enum": [
            "chat-frontend",
            "coding-agent",
            "automation",
            "voice-assistant",
            "sdk-framework",
            "roleplay-frontend",
            "agent-runtime"
          ]
        },
        "deployment": {
          "type": "string",
          "enum": ["self-hosted", "desktop", "cli", "library", "cloud-or-self-hosted"]
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "openai-chat",
              "openai-completions",
              "openai-responses",
              "openai-embeddings",
              "openai-images",
              "openai-audio-speech",
              "openai-audio-transcriptions",
              "anthropic-messages",
              "ollama-native",
              "gateway-native"
            ]
          }
        },
        "client_config": {
          "type": "object",
          "required": ["base_url_template", "auth"],
          "additionalProperties": false,
          "properties": {
            "base_url_template": {
              "type": "string",
              "description": "How the user points the client at the gateway. Uses ${PROXY_BASE_URL} as a placeholder for the gateway root."
            },
            "auth": {
              "type": "string",
              "enum": ["bearer", "x-api-key", "custom-header", "none"]
            },
            "auth_header": {
              "type": "string",
              "description": "Concrete header name when auth is 'custom-header'."
            },
            "extra_settings": {
              "type": "object",
              "description": "Free-form key/value hints (model id, feature toggles, etc.). Strings only.",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "description": "Gateway paths this client will hit during normal operation, relative to the gateway root.",
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "smoke_cases": {
          "type": "array",
          "minItems": 1,
          "description": "Named cases a future probe should map to the matrix. Names are case-grid keys: snake_case dotted, e.g. chat.streaming.",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "known_quirks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2"],
          "description": "P0: must-work, blocks gateway claims of compatibility. P1: high-value smoke target. P2: opportunistic / nice-to-have."
        },
        "status": {
          "type": "string",
          "enum": ["unverified", "manual-smoke", "automated-probe", "broken"],
          "description": "How far this target has been validated against the gateway today."
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
