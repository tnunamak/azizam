{
  "protocol": "engine-probe",
  "name": "locked-everywhere",
  "description": "Every path, the made-up one too, answers 401. Not seen on Tim's engines; the shape a server with a key on every path under /v1 has.",
  "provenance": {
    "source": "hand-written",
    "reference": "~/Documents/azizam/ux-findings/add-engine-probe-table.md (measured 2026-10-14): probe-table rule 3 (a 401 on every path, including the baseline)"
  },
  "exchanges": [
    {
      "id": "baseline-get",
      "match": {
        "method": "GET",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 401,
        "json": {
          "error": "Unauthorized"
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "baseline-post",
      "match": {
        "method": "POST",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 401,
        "json": {
          "error": "Unauthorized"
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "models",
      "match": {
        "method": "GET",
        "path": "/v1/models"
      },
      "response": {
        "status": 401,
        "json": {
          "error": "Unauthorized"
        }
      },
      "repeat": true,
      "required": false
    }
  ]
}
