{
  "protocol": "engine-probe",
  "name": "no-health-route",
  "description": "An OpenAI-compatible server that serves its model list and chat route and answers 404 for /health, as many such servers do.",
  "provenance": {
    "source": "hand-written",
    "reference": "first-run report: an engine the Add engine check verified failed every request because the request path read /health, which the check never tried"
  },
  "exchanges": [
    {
      "id": "baseline-get",
      "match": {
        "method": "GET",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "baseline-post",
      "match": {
        "method": "POST",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "models",
      "match": {
        "method": "GET",
        "path": "/v1/models"
      },
      "response": {
        "status": 200,
        "json": {
          "object": "list",
          "data": [
            {
              "id": "qwen3-32b-instruct-q4_k_m",
              "max_model_len": 40960
            }
          ]
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "openapi",
      "match": {
        "method": "GET",
        "path": "/openapi.json"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "capability-document",
      "match": {
        "method": "GET",
        "path": "/v1/models/capabilities"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "chat",
      "match": {
        "method": "POST",
        "path": "/v1/chat/completions"
      },
      "response": {
        "status": "{{chat_status}}",
        "json": "{{chat_reply}}"
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "embeddings",
      "match": {
        "method": "POST",
        "path": "/v1/embeddings"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "health",
      "match": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
