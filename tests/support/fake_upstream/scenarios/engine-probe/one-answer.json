{
  "protocol": "engine-probe",
  "name": "one-answer",
  "description": "One configurable answer for the model list, with a made-up-path baseline. Used for redirects, size caps, timeouts and empty lists.",
  "provenance": {
    "source": "hand-written",
    "reference": "~/Documents/azizam/ux-findings/add-engine-probe-table.md (measured 2026-10-14): spec section 5 safety rules"
  },
  "exchanges": [
    {
      "id": "baseline-get",
      "match": {
        "method": "GET",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "baseline-post",
      "match": {
        "method": "POST",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "models",
      "match": {
        "method": "GET",
        "path": "/v1/models"
      },
      "response": {
        "status": "{{status}}",
        "json": "{{body}}",
        "headers": "{{headers}}",
        "wait_before_headers": "{{wait}}"
      },
      "repeat": true,
      "required": false
    },
    {
