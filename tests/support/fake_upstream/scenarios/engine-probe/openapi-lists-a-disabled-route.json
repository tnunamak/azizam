{
  "protocol": "engine-probe",
  "name": "openapi-lists-a-disabled-route",
  "description": "The API description lists chat. The chat route answers 501 \"is disabled\", so chat is not supported. There is no model list.",
  "provenance": {
    "source": "hand-written",
    "reference": "~/Documents/azizam/ux-findings/add-engine-probe-table.md (measured 2026-10-14): realtime :8022"
  },
  "exchanges": [
    {
      "id": "baseline-get",
      "match": {
        "method": "GET",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "json": {
          "detail": "Not Found"
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "baseline-post",
      "match": {
        "method": "POST",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "json": {
          "detail": "Not Found"
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "models",
      "match": {
        "method": "GET",
        "path": "/v1/models"
      },
      "response": {
        "status": 404,
        "json": {
          "detail": "Not Found"
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "openapi",
      "match": {
        "method": "GET",
        "path": "/openapi.json"
      },
      "response": {
        "status": 200,
        "json": {
          "openapi": "3.1.0",
          "info": {
            "title": "FastAPI",
            "version": "0.1.0"
          },
          "paths": {
            "/v1/chat/completions": {
              "post": {
                "summary": "Unavailable Endpoint"
              }
            },
            "/v1/responses": {},
            "/v1/realtime/calls": {
              "post": {}
            }
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "capability-document",
      "match": {
        "method": "GET",
