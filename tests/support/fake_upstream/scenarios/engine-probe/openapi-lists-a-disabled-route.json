        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "chat",
      "match": {
        "method": "POST",
        "path": "/v1/chat/completions"
      },
      "response": {
        "status": 501,
        "json": {
          "error": {
            "message": "The LLM proxy is disabled. Start the server with --enable_llm_proxy to enable it.",
            "type": "not_implemented"
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
