{
  "protocol": "engine-probe",
  "name": "node-graph-405-everywhere",
  "description": "A node-graph server answers every POST with 405, the made-up path too, and lists model folders (strings) at /models. Read as an OpenAI-compatible server, nothing may look possible.",
  "provenance": {
    "source": "hand-written",
    "reference": "~/Documents/azizam/ux-findings/add-engine-probe-table.md (measured 2026-10-14): comfyui :7890"
  },
  "exchanges": [
    {
      "id": "baseline-get",
      "match": {
        "method": "GET",
        "path": "/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "body": [
          {
            "text": ""
          }
        ]
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "baseline-post",
      "match": {
        "method": "POST",
        "path": "/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 405,
        "body": [
          {
            "text": "405: Method Not Allowed"
          }
        ]
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "models",
      "match": {
        "method": "GET",
        "path": "/models"
      },
      "response": {
        "status": 200,
        "json": [
          "checkpoints",
          "configs",
          "loras",
          "vae",
          "text_encoders",
          "diffusion_models"
        ]
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "openapi",
      "match": {
        "method": "GET",
        "path": "/openapi.json"
      },
      "response": {
        "status": 404,
        "body": [
          {
            "text": ""
          }
        ]
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "capability-document",
      "match": {
        "method": "GET",
        "path": "/models/capabilities"
      },
      "response": {
        "status": 404,
        "body": [
          {
            "text": ""
          }
        ]
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "chat",
      "match": {
        "method": "POST",
        "path": "/chat/completions"
      },
      "response": {
        "status": 405,
        "body": [
          {
            "text": "405: Method Not Allowed"
          }
        ]
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "embeddings",
      "match": {
        "method": "POST",
        "path": "/embeddings"
      },
      "response": {
        "status": 405,
        "body": [
          {
            "text": "405: Method Not Allowed"
          }
        ]
      },
      "repeat": true,
      "required": false
    }
  ]
}
