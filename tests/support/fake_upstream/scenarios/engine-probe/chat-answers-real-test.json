{
  "protocol": "engine-probe",
  "name": "chat-answers-real-test",
  "description": "A chat server whose model list names one model and whose chat route answers a one-token request.",
  "provenance": {
    "source": "hand-written",
    "reference": "~/Documents/azizam/ux-findings/add-engine-probe-table.md (measured 2026-10-14): real test, spec section 2 step 4"
  },
  "exchanges": [
    {
      "id": "baseline-get",
      "match": {
        "method": "GET",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "baseline-post",
      "match": {
        "method": "POST",
        "path": "/v1/zz-not-a-route-{{token}}"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "models",
      "match": {
        "method": "GET",
        "path": "/v1/models"
      },
      "response": {
        "status": 200,
        "json": {
          "object": "list",
          "data": [
            {
              "id": "qwen3-32b-instruct-q4_k_m",
              "max_model_len": 40960
            }
          ]
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "openapi",
      "match": {
        "method": "GET",
        "path": "/openapi.json"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "capability-document",
      "match": {
        "method": "GET",
        "path": "/v1/models/capabilities"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "message": "File Not Found",
            "type": "not_found_error",
            "code": 404
          }
        }
      },
      "repeat": true,
      "required": false
    },
    {
      "id": "chat",
      "match": {
        "method": "POST",
        "path": "/v1/chat/completions"
      },
      "response": {
        "status": "{{chat_status}}",
