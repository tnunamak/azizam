{
  "protocol": "typesafe-systemone",
  "name": "answer",
  "description": "A decision answer with provider-reported cost.",
  "provenance": {
    "source": "hand-written",
    "reference": "gateway/providers.py call_typesafe_systemone (POST /v1/systemone, JSON answers keyed by question, usage.cost)"
  },
  "exchanges": [
    {
      "id": "decide",
      "match": {
        "method": "POST",
        "path": "/v1/systemone",
        "headers": {
          "authorization": "Bearer {{api_key}}"
        },
        "json": {
          "model": "{{model}}"
        }
      },
      "response": {
        "json": {
          "model": "{{model}}",
          "answers": {
            "q": {
              "type": "noul",
              "noul": 1.0
            }
          },
          "usage": {
            "input_tokens": 1000,
            "output_tokens": 0,
            "cost": "0.000123"
          }
        }
      }
    }
  ]
}
