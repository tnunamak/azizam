{
  "protocol": "typesafe-systemone",
  "name": "answer-disconnect",
  "description": "Headers and the first bytes of the answer arrive, then the connection drops.",
  "provenance": {
    "source": "hand-written",
    "reference": "gateway/providers.py call_typesafe_systemone (POST /v1/systemone, JSON answers keyed by question, usage.cost)"
  },
  "exchanges": [
    {
      "id": "decide",
      "match": {
        "method": "POST",
        "path": "/v1/systemone",
        "headers": {
          "authorization": "Bearer {{api_key}}"
        },
        "json": {
          "model": "{{model}}"
        }
      },
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "text": "{\"model\":\"{{model}}\",\"ans"
          },
          {
            "disconnect": true
          }
        ]
      }
    }
  ]
}
