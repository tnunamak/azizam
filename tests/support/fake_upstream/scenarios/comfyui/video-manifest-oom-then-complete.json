{
  "protocol": "comfyui",
  "name": "video-manifest-oom-then-complete",
  "description": "The submit is refused with an out-of-memory text; ComfyUI is idle, so the gateway frees models and submits again, and the job completes.",
  "provenance": {
    "source": "hand-written",
    "reference": "ComfyUI server routes POST /upload/image, POST /prompt, GET /history/{prompt_id}, GET /view (ComfyUI server.py); the gateway polls history, it does not use the websocket"
  },
  "exchanges": [
    {
      "id": "upload",
      "match": {
        "method": "POST",
        "path": "/upload/image"
      },
      "response": {
        "json": {
          "name": "uploaded-sample.mp4"
        }
      }
    },
    {
      "id": "prompt-oom",
      "match": {
        "method": "POST",
        "path": "/prompt"
      },
      "response": {
        "status": 500,
        "body": [
          {
            "text": "CUDA out of memory. Tried to allocate 2.00 GiB"
          }
        ]
      }
    },
    {
      "id": "queue",
      "match": {
        "method": "GET",
        "path": "/queue"
      },
      "response": {
        "json": {
          "queue_running": [],
          "queue_pending": []
        }
      }
    },
    {
      "id": "free",
      "match": {
        "method": "POST",
        "path": "/free",
        "json": {
          "unload_models": true,
          "free_memory": true
        }
      },
      "response": {
        "json": {}
      }
    },
    {
      "id": "prompt",
      "match": {
        "method": "POST",
        "path": "/prompt"
      },
      "response": {
        "json": {
          "prompt_id": "prompt-1"
        }
      }
    },
    {
      "id": "history",
      "match": {
        "method": "GET",
        "path": "/history/prompt-1"
      },
      "response": {
        "json": {
          "prompt-1": {
            "status": {
              "completed": true
            },
            "outputs": {
              "6": {
                "videos": [
                  {
                    "filename": "rife.mp4",
                    "type": "output"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "view",
      "match": {
        "method": "GET",
        "path": "/view",
        "query": {
          "filename": "rife.mp4",
          "type": "output"
        }
      },
      "response": {
        "headers": {
          "content-type": "video/mp4"
        },
        "body": [
          {
            "text": "rendered-video"
          }
        ]
      }
    }
  ]
}
