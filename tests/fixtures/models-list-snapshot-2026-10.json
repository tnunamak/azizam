   "vivid_fish_manifest_version": "0.1.0",
   "vivid_fish_workflow": true,
   "vivid_fish_workflow_id": "image.edit.qwen-image-2.1-edit"
  },
  {
   "created": 1790995784,
   "description": "Put the real people from one or more reference photos into a new scene or pose and return the best of N seeds with objective likeness scores. The gateway crops a roomy head per person from the ORIGINAL photo (never a tiny face tile), tags every input <imageN> for Qwen-Image 2.1 multi-reference edit, runs up to `attempts` seeds, scores each result with ArcFace (buffalo_l + antelopev2, CPU) against the real faces, and keeps the best. Served at POST /gateway/v1/images/identity (typed; async media job by default, sync with mode=sync, JSON with `likeness`) and at POST /v1/images/edits with model=image-identity (options in extensions[\"com.vividfish.workflow\"]). Infant faces are scored but flagged reliability=low: the score only ranks candidates, so verify a baby by eye. Measured on a family photo: 0.60 adult, 0.48 infant (docs/IDENTITY_LIKENESS.md).",
   "id": "image-identity",
   "object": "model",
   "owned_by": "vivid-fish",
   "vivid_fish_alias": true,
   "vivid_fish_backend": "gateway",
   "vivid_fish_intent": "image.edit",
   "vivid_fish_manifest_version": "0.1.0",
   "vivid_fish_resolves_to": {
    "image_edits": "image-identity"
   },
   "vivid_fish_workflow": true,
   "vivid_fish_workflow_id": "image.edit.image-identity"
  },
