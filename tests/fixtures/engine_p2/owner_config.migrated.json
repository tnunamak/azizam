    },
    "parakeet-gpu": {
     "service": "stt-parakeet-gpu",
     "model": "parakeet-tdt-0.6b-v3",
     "upload_format": "wav16k",
     "placement": "audio.cpp on GPU0 (about 2.3-3.2 GB while loaded; weights unload after 5 min idle), on-demand unit",
     "description": "Parakeet TDT 0.6B v3 q8 on GPU0 (same model as `parakeet`, no blanked spans: 5 min set WER 1.5% in 1.1 s vs 2.05% in 13.8 s on CPU)"
    },
    "nemotron-streaming": {
     "service": "stt-nemotron",
     "model": "nemotron-3.5-asr-streaming-0.6b",
