    }
   },
   "stable": {
    "tts": [
     "supertonic",
     "omnivoice"
    ],
    "tts-fast": [
     "supertonic",
     "omnivoice"
    ],
    "tts-quality": [
     "omnivoice",
     "kokoro"
    ]
   },
   "openai": [
    {
     "match": "tts-1",
     "to": "tts"
    },
    {
     "match": "tts-1-hd",
     "to": "tts-quality"
    },
    {
     "match": "gpt-4o*-tts*",
     "to": "tts"
    }
   ]
  },
  "transcriptions": {
   "engines": {
    "parakeet": {
     "service": "stt",
     "model": "parakeet-tdt-0.6b-v3",
     "description": "NVIDIA Parakeet TDT 0.6B v3 (CPU service; long audio is chunked by the gateway)"
    },
    "parakeet-gpu": {
     "service": "stt-parakeet-gpu",
     "model": "parakeet-tdt-0.6b-v3",
     "upload_format": "wav16k",
     "placement": "audio.cpp on GPU0 (about 2.3-3.2 GB while loaded; weights unload after 5 min idle), on-demand unit",
     "description": "Parakeet TDT 0.6B v3 q8 on GPU0 (same model as `parakeet`, no blanked spans: 5 min set WER 1.5% in 1.1 s vs 2.05% in 13.8 s on CPU)"
    },
    "nemotron-streaming": {
     "service": "stt-nemotron",
     "model": "nemotron-3.5-asr-streaming-0.6b",
     "stream_model": "nemotron-3.5-asr-streaming-0.6b-stream",
     "streaming": true,
     "upload_format": "wav16k",
     "placement": "audio.cpp on GPU0 (~2.2 GB with both modes loaded, always loaded: never unloaded when idle), always-warm unit started at boot",
     "description": "Nemotron streaming (bake-off: 194 ms end-of-speech to final)"
    },
    "canary": {
     "service": "stt-canary",
     "model": "canary-180m-flash",
     "upload_format": "wav16k",
     "placement": "audio.cpp on GPU0 (~0.9 GB while loaded; weights unload after 5 min idle), on-demand unit",
     "description": "Canary 180M Flash (low VRAM, strong clean-speech WER)"
    },
    "nemotron-diarize": {
     "service": "stt-diarize",
     "model": "nemotron-3-diarization",
     "streaming": true,
     "placement": "CPU only (about 1.5 GB RAM; exits after 15 min idle), on-demand unit; words come from the Parakeet service",
     "description": "Nemotron 3 Diarization (speakers) + Parakeet TDT (word timestamps): gpt-4o-transcribe-diarize shape, diarized_json"
    }
   },
   "stable": {
    "stt": [
     "parakeet-gpu",
     "parakeet"
    ],
    "stt-fast": [
     "nemotron-streaming",
     "parakeet"
    ],
    "stt-quality": [
     "parakeet-gpu",
     "parakeet",
     "canary"
    ],
    "stt-diarize": [
     "nemotron-diarize"
    ]
   },
   "openai": [
    {
     "match": "*transcribe-diarize*",
     "to": "stt-diarize"
    },
    {
     "match": "whisper*",
     "to": "stt"
    },
    {
     "match": "parakeet-*",
     "to": "stt"
    },
    {
     "match": "gpt-4o-mini-transcribe*",
     "to": "stt-fast"
    },
    {
     "match": "gpt-4o*transcribe*",
     "to": "stt-quality"
    },
    {
     "match": "*transcribe*",
     "to": "stt"
    }
   ]
  }
 },
