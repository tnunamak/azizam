     "streaming": true,
     "upload_format": "wav16k",
     "placement": "audio.cpp on GPU0 (~2.2 GB with both modes loaded, always loaded: never unloaded when idle), always-warm unit started at boot",
     "description": "Nemotron streaming (bake-off: 194 ms end-of-speech to final)"
    },
    "canary": {
     "service": "stt-canary",
     "model": "canary-180m-flash",
     "upload_format": "wav16k",
