    "chatterbox": {
     "service": "tts-chatterbox",
     "model": "chatterbox-turbo",
     "voice_transform": "voxtral-voices",
     "streaming": true,
     "native_sample_rate": 24000,
     "custom_voices": true,
     "placement": "Python server on GPU0 (about 3.1 GB while running, weights never unloaded while the process lives), on-demand unit. Temporarily disabled since 2026-10-08.",
     "default_voice": "alloy",
     "voices": [
      "alloy",
      "ash",
      "ballad",
      "cedar",
      "coral",
      "echo",
      "fable",
      "marin",
      "nova",
