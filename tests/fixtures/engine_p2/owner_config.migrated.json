   ]
  }
 },
 "voices": {
  "dir": "data/voices",
  "consent_mode": "optional",
  "max_voices_per_key": 20,
  "max_consents_per_key": 50,
  "max_bytes_per_key": 209715200,
  "max_upload_bytes": 10485760,
  "min_seconds": 5,
  "max_seconds": 60,
  "min_speech_seconds": 3.5,
  "target_seconds": 12,
  "quality_engine": "chatterbox",
  "quality_warn_below": 0.45,
  "design_engine": "omnivoice"
 },
 "backends": {
  "stt": {
   "enabled": true,
   "host": "127.0.0.1",
   "port": 5092,
   "base_path": "/v1",
   "capabilities": [
    "audio",
    "transcriptions"
   ],
   "default_model": "parakeet-tdt-0.6b-v3",
   "timeout": 120,
   "chunking": {
    "backend_timeout_seconds": 180,
    "deadline_seconds": 360,
    "enabled": true,
    "global_concurrency": 2,
    "max_channels": 2,
    "max_decoded_bytes": 1073741824,
    "max_duration_seconds": 14400,
    "max_field_bytes": 65536,
    "max_fields": 100,
    "max_files": 8,
    "max_input_bytes": 536870912,
    "max_media_output_bytes": 8388608,
    "max_response_bytes": 16777216,
    "max_sample_rate": 48000,
    "max_segments": 16,
    "min_free_bytes": 67108864,
    "setup_failure_policy": "passthrough",
    "silence_min_seconds": 0.5,
    "silence_noise_db": "-30dB",
    "silence_search_seconds": 120,
    "spool_dir": "data/stt-spool",
    "target_seconds": 150,
    "threshold_seconds": 180
   },
   "priority": 100,
   "role": "required",
   "native_passthrough": true,
   "transforms": [
    {
     "kind": "drop-params",
     "phase": "response",
     "drop": [
      "timing"
     ]
    }
   ]
  },
  "stt-canary": {
   "enabled": true,
   "host": "127.0.0.1",
   "port": 8013,
   "base_path": "/v1",
   "capabilities": [
    "audio",
