# =============================================================================
# Secrets and runtime state — NEVER commit
# =============================================================================
proxy_api_keys.yml
cache/
*.url_signing_secret

# Metrics persistence: schema is committed via .gitkeep; the DB itself
# is ephemeral runtime state.
data/metrics.db
data/metrics.db-wal
data/metrics.db-shm
data/metrics.db.broken-*

# Responses API persistence: SQLite store for /v1/responses stateful
# conversations, kept until explicit deletion.
data/responses.db
data/responses.db-wal
data/responses.db-shm
data/responses.db.broken-*

# Media jobs persistence: SQLite store for generic gateway media jobs and
# their event log. Ephemeral runtime state.
data/media_jobs.db
data/media_jobs.db-wal
data/media_jobs.db-shm
data/media_jobs.db.broken-*

# Gateway route receipts persistence. Ephemeral runtime diagnostics.
data/receipts.db
data/receipts.db-wal
data/receipts.db-shm
data/receipts.db.broken-*

# Admin/control-plane persistence. Runtime state; never commit hashes,
# sessions, or audit rows from a live deployment.
data/admin.db
data/admin.db-wal
data/admin.db-shm
data/admin.db.broken-*

# Store admission locks (gateway/sqlite_startup.py). Never delete while running.
data/*.db.lock
data/admin.db.bak.*
data/admin_session_key
data/admin_session_key.tmp
data/migration-backups/

# Stray root-level copy of the admin DB (never a canonical location).
/admin.db

# Bounded STT request workspaces can contain raw audio during a request and
# must never become stageable after a crash or a mandatory-cleanup failure.
data/stt-spool/

# The gateway's private temporary directory: multipart spill, STT workspaces, ffmpeg scratch.
# Emptied at every start; may hold request content while a request runs.
data/private-tmp/

# LiteLLM sidecar config is generated from the DB-owned service registry.
# It is runtime state, not an editable source of truth. Generated backup/
# snapshot copies of it are equally non-canonical.
data/litellm.config.yaml
data/litellm.config.yaml.*
data/litellm.pid

# Core dumps — may contain in-memory secrets/session tokens.
/core
core.[0-9]*
*.core

# GPU incident snapshots — ephemeral diagnostic captures written by
# ~/.local/bin/gpu-incident-watcher
data/incidents/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
venv/
.venv/
env/
ENV/

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# =============================================================================
# Status page (Next.js)
# =============================================================================

# Optional Node SDK compatibility probes. The lockfile is committed; the
# installed dependency tree is local runtime state.
tests/compat/node/node_modules/
tests/conformance/node_modules/
.ci-conformance-venv/

# =============================================================================
# Editor / OS
# =============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# =============================================================================
# Logs and ephemera
# =============================================================================
*.log
*.bak
*.orig
*.orig.bak
*.obsolete
proxy_config.yml.bak

# Workflow scratch — backups, drafts, and obsolete files are non-canonical
workflows/.backup-*/
workflows/_drafts/
workflows/*.obsolete

# Local multi-agent workstream state. Worker prompts, handoff reports, and
# linked Claude worktrees are coordination artifacts, not project source.
tmp/workstreams/
.claude/worktrees/

# =============================================================================
# Local config / overrides
# =============================================================================
.env
.env.local
*.local.yml

# User-created voices and consent recordings (per-key, private)
data/voices/

# Pending image-job spool (runtime state; private request bodies)
data/image_media_jobs/

# Private throwaway UI test state
/.ui-e2e-state/

# Paid-provider spend ledger (runtime state, beside the admin DB)
data/provider_spend.db
data/provider_spend.db-*

# Provider secret store key (0600) and mutation lock: runtime state, never commit
data/provider-secrets.key
data/.provider-mutation.lock
