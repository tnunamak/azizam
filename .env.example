# Copy this file to .env and fill in the values you need.
# Most settings have safe defaults; only override what you must.

# --- Listener ---
# AZIZAM_PORT=5000

# --- Persistent state paths (default: data/ next to proxy.py) ---
# AZIZAM_ADMIN_DB=/app/data/admin.db
# AZIZAM_RESPONSES_DB=/app/data/responses.db
# AZIZAM_METRICS_DB=/app/data/metrics.db
# AZIZAM_RECEIPTS_DB=/app/data/receipts.db
# AZIZAM_MEDIA_JOBS_DB=/app/data/media_jobs.db

# --- Admin session secret (auto-generated and persisted if omitted) ---
# AZIZAM_ADMIN_SESSION_KEY=change-me-to-a-long-random-string

# --- Deployment brand (optional; data, not product code) ---
# A generic install shows only the neutral product label. Set a wordmark to
# render a stylized "name.tld" mark in the header for your deployment.
# AZIZAM_BRAND=Azizam
# AZIZAM_WORDMARK=ai.example.com
