# Copy this file to .env and fill in the values you need.
# Most settings have safe defaults; only override what you must.

# --- Listener ---
# OPENAI_PROXY_PORT=5000

# --- Persistent state paths (default: data/ next to proxy.py) ---
# AI_GATEWAY_ADMIN_DB=/app/data/admin.db
# AI_GATEWAY_RESPONSES_DB=/app/data/responses.db
# AI_GATEWAY_METRICS_DB=/app/data/metrics.db

# --- Admin session secret (auto-generated and persisted if omitted) ---
# AI_GATEWAY_ADMIN_SESSION_KEY=change-me-to-a-long-random-string
