# User unit for the CPU face sidecar (likeness check + image-identity).
# Install: cp to ~/.config/systemd/user/ and `systemctl --user daemon-reload`.
# The gateway starts it on demand; it exits with status 0 after --idle-exit-s idle seconds.
[Unit]
Description=Face service (insightface, CPU) for the gateway likeness check, port 8021
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/applications/openai-proxy/services/face-service
Environment=CUDA_VISIBLE_DEVICES=
Environment="FACE_MODEL_ROOT=/media/windows/AI Models/insightface"
Environment=FACE_ORT_THREADS=4
ExecStart=%h/applications/face-service/venv/bin/python %h/applications/openai-proxy/services/face-service/server.py --port 8021 --idle-exit-s 900
Restart=on-failure
RestartSec=10
LimitCORE=0

[Install]
WantedBy=default.target
