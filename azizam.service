[Unit]
Description=Azizam - Unified local AI API for local LLM/TTS/STT/ComfyUI
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/applications/azizam
ExecStart=%h/applications/azizam/start.sh
Restart=on-failure
RestartSec=10

# Environment
Environment="AZIZAM_PORT=5000"
Environment="TTS_ENABLED=true"
Environment="TTS_HOST=http://127.0.0.1:8001"

# Graceful stop: SIGTERM goes to start.sh only, which forwards it to the proxy
# and stops LiteLLM after the proxy exits. uvicorn waits up to
# AZIZAM_GRACEFUL_SHUTDOWN_S (120) for in-flight responses; systemd
# SIGKILLs everything left at TimeoutStopSec. See docs/ops/SAFE_RESTART.md.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=150s

# Temporary files. start.sh points TMPDIR at data/private-tmp (mode 0700, on disk, emptied at start), so every
# temporary file of the gateway, LiteLLM, ffmpeg and the engines it starts lands there. PrivateTmp=yes adds a private
# /tmp where the host allows it. In a user unit it needs unprivileged user namespaces. On a host that restricts them
# (Ubuntu with kernel.apparmor_restrict_unprivileged_userns=1) systemd accepts the line and /tmp stays shared, so the
# private TMPDIR is the protection; the line also makes the unit run in its own user namespace, where sudo stops working.
PrivateTmp=yes

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=default.target
