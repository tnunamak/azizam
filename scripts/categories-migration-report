#!/usr/bin/env python3
"""Compare legacy exact, gated legacy and category v3 on an admin.db snapshot.

Run with the gateway venv Python. No database initialization or writes.
Only plan IDs, counts and synthetic request labels appear in output.
"""

from __future__ import annotations

import argparse
import sqlite3
import sys
from contextlib import closing
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from gateway.category_migration import (  # noqa: E402
    load_database, open_database, registry_matrix, report_plan, scan_callsites,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("database", type=Path, help="private admin.db snapshot")
    parser.add_argument("--examples", type=int, default=3, help="first N changes per comparison per plan")
    args = parser.parse_args()
    if args.examples < 0:
        parser.error("--examples must be nonnegative")
    try:
        with closing(open_database(args.database)) as conn:
            profiles, registry = load_database(conn)
        matrix = registry_matrix(registry)
        if not matrix:
            raise ValueError("empty registry matrix")
        reports = [report_plan(p, matrix, examples=args.examples) for p in profiles]
    except (sqlite3.Error, ValueError, TypeError, KeyError):
        # Profile parse errors may contain personal strings. Do not echo them.
        print("error: cannot read a valid profile/registry snapshot", file=sys.stderr)
        return 1
    print(f"plans={len(reports)} registry_requests={len(matrix)}")
    print("plan_id\trequests\t1->2\t1->3")
    for report in reports:
        print(f"{report.plan_id}\t{len(report.comparisons)}\t{report.gate_changes}\t{report.v3_changes}")
        for label, examples in (("1->2", report.gate_examples), ("1->3", report.v3_examples)):
            for item in examples:
                # Legacy prose may embed private target IDs; stable reason
                # classes preserve the cause without disclosing those strings.
                reasons = "ALLOW" if item.exact.allowed else "LEGACY_DENY"
                result = item.gated if label == "1->2" else item.v3
                outcome = ("allow" if result.allowed else "deny") if label == "1->2" else result.outcome
                reason = ("METADATA_INCOMPLETE" if label == "1->2" else result.reason)
                print(f"  {label} {item.case.label} phase={item.case.phase} "
                      f"legacy={reasons} -> {outcome}:{reason}")
    print(f"total requests={sum(len(r.comparisons) for r in reports)} "
          f"1->2={sum(r.gate_changes for r in reports)} 1->3={sum(r.v3_changes for r in reports)}")
    sites = scan_callsites(ROOT)
    blocked = [s for s in sites if s.metadata in {"omitted", "none", "empty"}]
    dynamic = [s for s in sites if s.metadata == "dynamic"]
    print(f"static callsites={len(sites)} no_tag_metadata={len(blocked)} dynamic={len(dynamic)}")
    print("Clients using these paths with tag-restricted plans would fail the completeness gate:")
    for site in blocked:
        print(f"  {site.path}:{site.line} {site.function} "
              f"routes={','.join(site.routes) or 'caller-dependent'} tags={site.metadata}")
    print("Dynamic arguments require tracing; this scan cannot identify actual clients or usage:")
    for site in dynamic:
        print(f"  {site.path}:{site.line} {site.function} routes={','.join(site.routes) or 'caller-dependent'}")
    print("Finite synthetic preview: no owner acceptance, real dependency graph or runtime activation implied.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
