#!/usr/bin/env bash
# Run every CI job on an exact commit and retain per-step receipts.
# Usage: scripts/ci-local [--force] [--order-seed N] [--port N] [--browser-workers N] [--browser-servers N] [--py-workers N] [--skip-compose]
#        scripts/ci-local --force --signoff --target BRANCH [--closes-nightly-red N] [...]
# Independent jobs run in isolated detached worktrees; browser tests share one build.
# Test order follows a seed, random unless given and always printed.
# A passed tree is not rerun unless --force is given. See docs/ops/CI.md.
set -euo pipefail
[[ -n ${AZIZAM_PRIORITY_SET:-} ]] || exec "${BASH_SOURCE[0]%/*}/low-priority" "${BASH_SOURCE[0]}" "$@"

signoff=0 force=0 port=18640 browser_workers=4 browser_servers=2 py_workers=12 skip_compose=0
seed=$(((RANDOM * 32768 + RANDOM) % 1000000000)) target= closes_nightly_red=
while (($#)); do
  case $1 in
    --signoff) signoff=1 ;;
    --force) force=1 ;;
    --port|--browser-workers|--browser-servers|--py-workers|--order-seed|--target|--closes-nightly-red)
      (($# >= 2)) || { echo "$1 requires a value" >&2; exit 2; }
      case $1 in
        --port) port=$2 ;; --browser-workers) browser_workers=$2 ;; --browser-servers) browser_servers=$2 ;; --py-workers) py_workers=$2 ;;
        --order-seed) seed=$2 ;; --target) target=$2 ;; *) closes_nightly_red=$2 ;;
      esac
      shift ;;
    --skip-compose) skip_compose=1 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done
# Each fixture gateway owns ten ports: gateway +0, engine +1, strict probes
# +2..+9. Up to six gateways: the parallel pool (1-3 servers), the global-state
# server, live-data and household. Bound inputs before arithmetic.
if [[ ! $port =~ ^18[0-9]{3}$ || ! $browser_workers =~ ^([1-9]|1[0-6])$ || ! $browser_servers =~ ^[1-3]$ || ! $py_workers =~ ^[1-9][0-9]?$ ]]; then
  echo "--port must be 18000-18998, --browser-workers 1-16, --browser-servers 1-3 and --py-workers a positive integer <= 99" >&2
  exit 2
fi
if ((port + 69 > 18998)); then
  echo "the browser fixture gateways must fit within 18000-18998" >&2
  exit 2
fi
if [[ ! $seed =~ ^[0-9]{1,9}$ ]]; then
  echo "--order-seed must be an integer from 0 to 999999999" >&2
  exit 2
fi
if [[ -n $closes_nightly_red && ! $closes_nightly_red =~ ^[1-9][0-9]*$ ]]; then
  echo "--closes-nightly-red must be an issue number" >&2
  exit 2
fi
if ((!signoff)) && [[ -n $target || -n $closes_nightly_red ]]; then
  echo "--target and --closes-nightly-red apply only with --signoff" >&2
  exit 2
fi
command -v setsid >/dev/null || { echo "ci-local requires setsid" >&2; exit 2; }
command -v flock >/dev/null || { echo "ci-local requires flock" >&2; exit 2; }

repo=$(git rev-parse --show-toplevel)
cd "$repo"
if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
  echo "ci-local runs on HEAD: commit or stash tracked changes first" >&2
  exit 2
fi
sha=$(git rev-parse HEAD)
tree=$(git rev-parse 'HEAD^{tree}')
receipts_root=${AZIZAM_CI_RECEIPTS:-$HOME/.tmp/azizam-ci-receipts}
receipts=$receipts_root/$tree

# A signoff attests that this invocation ran every required step on the exact
# merge candidate (docs/design/TEST_STRATEGY.md 1.2). Each rule that does not
# hold refuses with exit 3, posts nothing and writes no signoff receipt.
refuse() { echo "signoff refused: $*" >&2; exit 3; }
remote_tip() { git ls-remote --exit-code origin "refs/heads/$target" | cut -f1; }
check_nightly_red() {
  local open number
  open=$(gh issue list --label nightly-red --state open --json number --jq '.[].number') ||
    refuse "cannot list open nightly-red issues"
  for number in $open; do
    [[ $number == "$closes_nightly_red" ]] ||
      refuse "open nightly-red issue #$number blocks signoff; pass --closes-nightly-red $number only if this change closes it"
    # The same keywords GitHub uses to close an issue when the commit lands.
    git log --format=%B "$target_tip..$sha" |
      grep -qiE "\b(close[sd]?|fix(e[sd])?|resolve[sd]?) #$number\b" ||
      refuse "no commit in $target_tip..$sha says it closes nightly-red issue #$number (e.g. \"Fixes #$number\")"
  done
}
if ((signoff)); then
  ((force)) || refuse "--signoff needs --force: a signoff never comes from the tree cache"
  [[ -n $target ]] || refuse "--signoff needs --target BRANCH"
  ((!skip_compose)) || refuse "--skip-compose skips a required step"
  target_tip=$(remote_tip) || refuse "cannot read refs/heads/$target from origin"
  parent=$(git rev-parse -q --verify 'HEAD^1') || parent=none
  [[ $parent == "$target_tip" ]] ||
    refuse "HEAD^1 is $parent, not the origin/$target tip $target_tip; run on the merge candidate (the $target tip with the change merged)"
  # The status is posted to the SHA by name, and GitHub rejects a commit it has
  # not received: push the candidate to a branch first, not after a 10-minute run.
  gh api "repos/{owner}/{repo}/commits/$sha" --silent 2>/dev/null ||
    refuse "GitHub has no commit $sha; push the merge candidate to a branch (not $target) first"
  check_nightly_red
fi

# Two gates on one host would share 24 cores and the 18000-18998 ports.
# Every job inherits the lock descriptor, so if ci-local itself is killed,
# its surviving jobs keep the host locked until they end.
lock=$HOME/.tmp/azizam-ci.lock
mkdir -p "${lock%/*}"
exec 9>>"$lock"
if ! flock -n 9; then
  echo "waiting for the host CI lock $lock (last recorded holder: $(cat "$lock"); current holders: fuser -v $lock)"
  flock 9
fi
printf 'pid %s sha %s since %s\n' "$$" "$sha" "$(date -u +%FT%TZ)" > "$lock"

if [[ -f $receipts/PASS && $force == 0 ]]; then
  echo "tree $tree already passed (receipts: $receipts)"
  exit 0
fi
echo "order seed: $seed (reproduce with --order-seed $seed)"

scratch=${AZIZAM_CI_SCRATCH:-$HOME/.tmp}
mkdir -p "$scratch" "$receipts/logs"
receipts=$(cd "$receipts" && pwd)
rm -f "$receipts/PASS" "$receipts/steps.tsv" "$receipts/cases.jsonl" "$receipts/signoff-$sha.tsv"
rm -rf "$receipts/steps" "$receipts/test-results" "$receipts/raw"
mkdir -p "$receipts/steps" "$receipts/raw"
# A run directory holds worktrees and dependency copies (about 7 GB). Exit
# removes it, except that the latest failed run's directory is kept for
# debugging, named in $kept. With the lock held, no other run is live, so any
# other marked directory was left by a killed run and is removed here.
kept=$scratch/azizam-ci-local.kept
remove_run_dir() { rm -rf -- "$1"; git -C "$repo" worktree prune; }
for directory in "$scratch"/azizam-ci-local.*/; do
  directory=${directory%/}
  if [[ -f $directory/.ci-local-run && $directory != "$(cat "$kept" 2>/dev/null)" ]]; then
    remove_run_dir "$directory"
  fi
done
run=$(mktemp -d "$scratch/azizam-ci-local.XXXXXXXX")
run=$(cd "$run" && pwd)
: > "$run/.ci-local-run"
keep_run=0
work=$run/web-build
worktrees=()
pids=()
cleanup() {
  local pid directory deadline=$((SECONDS + 20))
  trap '' INT TERM
  # Every background job has its own session: never kill the caller's group.
  for pid in "${pids[@]}"; do kill -TERM -- "-$pid" 2>/dev/null || true; done
  for pid in "${pids[@]}"; do
    while kill -0 -- "-$pid" 2>/dev/null && ((SECONDS < deadline)); do sleep .2; done
    kill -KILL -- "-$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
  # Playwright starts each fixture server in its own session, so group kills
  # miss them; stop anything still running from this run's directory.
  pkill -TERM -f -- "$run/" 2>/dev/null || true
  deadline=$((SECONDS + 10))
  while pgrep -f -- "$run/" >/dev/null 2>&1 && ((SECONDS < deadline)); do sleep .2; done
  pkill -KILL -f -- "$run/" 2>/dev/null || true
  rm -f "$receipts/signoff-$sha.tsv.partial"
  cd "$repo"
  if ((keep_run)); then
    if [[ -f $kept && $(cat "$kept") != "$run" ]]; then remove_run_dir "$(cat "$kept")"; fi
    echo "$run" > "$kept"
    echo "kept the failed run's directory for debugging: $run"
    return
  fi
  for directory in "${worktrees[@]}"; do
    git worktree remove --force "$directory" >/dev/null 2>&1 || true
  done
  rm -rf "$run"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
add_worktree() {
  worktrees+=("$1")
  git -C "$repo" worktree add --quiet --detach "$1" "$sha"
}
add_worktree "$work"
add_worktree "$run/python"
add_worktree "$run/fresh"
started=$(date -u +%FT%TZ)
printf 'sha\t%s\ntree\t%s\nstarted\t%s\nseed\t%s\nbrowser_workers\t%s\npy_workers\t%s\nbase_port\t%s\n' "$sha" "$tree" "$started" "$seed" "$browser_workers" "$py_workers" "$port" > "$receipts/run.tsv"

failed=0
step() {
  local name=$1; shift
  local start=$SECONDS rc=0
  echo "== $name"
  # Run in the background and wait: a trapped INT or TERM interrupts wait at
  # once, while a foreground child would make bash defer or drop the signal.
  ( "$@" ) > "$receipts/logs/$name.log" 2>&1 &
  wait "$!" || rc=$?
  # One writer per file; aggregation happens only after every job is reaped.
  printf '%s\t%s\t%s\n' "$name" "$rc" "$((SECONDS - start))" > "$receipts/steps/$name.tsv"
  if ((rc)); then failed=1; echo "   FAILED (exit $rc): $receipts/logs/$name.log"; fi
  return 0
}
export receipts work skip_compose py_workers run seed
export -f step
start_job() {
  local directory=$1; shift
  setsid bash -c 'cd "$1" || exit; shift; "$@"' _ "$directory" "$@" &
  last_pid=$!
  pids+=("$last_pid")
}
wait_job() {
  local pid=$1 index deadline
  if ! wait "$pid"; then failed=1; fi
  # A failed supervisor must not leave fixture grandchildren running.
  if kill -0 -- "-$pid" 2>/dev/null; then
    failed=1
    kill -TERM -- "-$pid" 2>/dev/null || true
    deadline=$((SECONDS + 20))
    while kill -0 -- "-$pid" 2>/dev/null && ((SECONDS < deadline)); do sleep .2; done
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  # Remove reaped groups before cleanup, avoiding stale PID signalling.
  for index in "${!pids[@]}"; do
    if [[ ${pids[index]} == "$pid" ]]; then unset 'pids[index]'; break; fi
  done
}

# These jobs never share their venv, generated files or node_modules.
start_job "$run/python" bash -c '
  failed=0
  step python-hermetic scripts/run-hermetic-pytest.sh --junit-xml-out "$receipts/raw/pytest.xml" -q -rsx -n "$py_workers" --dist worksteal --order-seed "$seed"
  exit "$failed"
'
# The Compose journey creates and removes a Docker bridge network. Chromium
# aborts in-flight requests on any host network change (ERR_NETWORK_CHANGED),
# so Compose must never overlap the browser tests: it runs here, alongside web
# preparation, and the browser tests start only after it finishes. The native journey
# runs later, beside the browser tests: it needs no Docker network, and running it
# after Compose keeps the two from racing for the same free ports.
start_job "$run/fresh" bash -c '
  failed=0
  step fresh-venv bash -c "uv venv -q --python 3.12.13 .ci-fresh-venv && uv pip sync -q --no-build --strict --require-hashes --link-mode copy --python .ci-fresh-venv/bin/python tests/requirements-hermetic.lock"
  if ((skip_compose)); then
    printf "fresh-compose\tskipped\t0\n" > "$receipts/steps/fresh-compose.tsv"
    failed=1
    echo "== fresh-compose SKIPPED: the run cannot pass without it"
  else
    step fresh-compose env FRESH_INSTANCE_PYTHON="$PWD/.ci-fresh-venv/bin/python" scripts/e2e/fresh_instance.sh --compose
  fi
  exit "$failed"
'
fresh_pid=$last_pid
start_job "$work" bash -c '
  failed=0
  step web-npm-ci bash -c "cd web && npm ci --no-audit --no-fund"
  # Unit tests run beside the build, not beside the browser tests: there, CPU
  # contention pushed tests past the 5 s vitest limit. They finish before the
  # browser tests start.
  ( step web-unit env CASE_RECEIPTS_FILE="$receipts/raw/vitest.cases.jsonl" bash -c "cd web && npx vitest run --sequence.shuffle --sequence.seed \"\$1\" --reporter=default --reporter=./tests/case-receipts.ts" _ "$seed"; exit "$failed" ) &
  unit_pid=$!
  step web-check bash -c "cd web && npm run check"
  wait "$unit_pid" || failed=1
  step e2e-venv bash -c "uv venv -q --python 3.12 venv && uv pip sync -q --python venv/bin/python --require-hashes tests/requirements-hermetic.lock"
  step e2e-browser bash -c "cd web && npx playwright install chromium"
  exit "$failed"
'
web_pid=$last_pid
# The Node probes that run offline: probe-gates.test.mjs proves the opted-out
# live probes start no provider work. The live probes themselves stay with the
# scheduled tier (tests/suites.toml). Its own install keeps them out of web/.
start_job "$work" bash -c '
  failed=0
  step compat-node env CASE_RECEIPTS_FILE="$receipts/raw/compat-node.cases.jsonl" bash -c "cd tests/compat/node && npm ci --no-audit --no-fund && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=\"\$1\" --test-reporter-destination=stderr probe-gates.test.mjs" _ "$PWD/scripts/ci/node-case-receipts.mjs"
  exit "$failed"
'
compat_pid=$last_pid
wait_job "$web_pid"
wait_job "$fresh_pid"
wait_job "$compat_pid"

# The browser tests use the built export with the e2e venv and browser.
# Without them every journey fails with misleading 401/404s, so skip them and
# let the failed prerequisite be the reported cause.
browser_steps=4  # e2e-main, e2e-live-data, e2e-household, e2e-tree-unchanged
browser_ready=1
for prerequisite in web-npm-ci web-check e2e-venv e2e-browser; do
  rc=$(cut -f2 "$receipts/steps/$prerequisite.tsv" 2>/dev/null || echo missing)
  if [[ $rc != 0 ]]; then browser_ready=0; fi
done
if ((!browser_ready)); then
  failed=1
  echo "== browser tests skipped: a web build prerequisite failed (see above)"
  browser_steps=0
fi

# Isolation comes from data, not copies (TEST_STRATEGY.md 3.4.7): every
# Playwright invocation runs from the one build tree, which no test writes.
# Runner and spec output goes to web/test-results, a link to a directory
# outside the tree; e2e-tree-unchanged fails if anything else in web/ changes.
# Ports: the main pool +10 and its global-state server +20 (one invocation
# with --browser-workers workers over --browser-servers servers; extra pool
# servers at +50 and +60), live-data +30, household +40.
browser_names=(e2e-main e2e-live-data e2e-household)
browser_configs=(playwright.config.ts playwright.live-data.config.ts playwright.household.config.ts)
browser_ports=($((port + 10)) $((port + 30)) $((port + 40)))
if ((browser_ready)); then
  mkdir -p "$run/browser-results" "$run/state"
  rm -rf "$work/web/test-results"  # nothing before this point writes there
  ln -s "$run/browser-results" "$work/web/test-results"
  touch "$run/browser-start"
  for i in 0 1 2; do
    start_job "$work/web" bash -c '
      failed=0
      name=$1; shift
      step "$name" "$@"
      exit "$failed"
    ' _ "${browser_names[i]}" env UI_E2E_PORT="${browser_ports[i]}" UI_E2E_WORKERS="$browser_workers" UI_E2E_POOL="$browser_servers" \
      UI_E2E_STATE_ROOT="$run/state/${browser_names[i]}" UI_E2E_RUN_ID="$seed" UI_E2E_PYTHON="$work/venv/bin/python" \
      CASE_RECEIPTS_FILE="$receipts/raw/${browser_names[i]}.cases.jsonl" \
      ./node_modules/.bin/playwright test --config "${browser_configs[i]}"
  done
fi
start_job "$run/fresh" bash -c '
  failed=0
  step fresh-native env FRESH_INSTANCE_PYTHON="$PWD/.ci-fresh-venv/bin/python" scripts/e2e/fresh_instance.sh
  exit "$failed"
'
for pid in "${pids[@]}"; do wait_job "$pid"; done
if ((browser_ready)); then
  step e2e-tree-unchanged bash -c 'changed=$(find "$1/web" -path "$1/web/test-results" -prune -o -newer "$2" -print)
    [[ -z $changed ]] || { echo "browser tests wrote into the shared build tree:"; echo "$changed"; exit 1; }' _ "$work" "$run/browser-start"
fi

# Case receipts: one cases.jsonl from every framework's report, then the
# test policy over it and the clean tree (docs/design/TEST_STRATEGY.md 3, 6).
merge_args=(--pytest "$receipts/raw/pytest.xml" "$run/python" --receipts "$receipts/raw/vitest.cases.jsonl" "$work")
if [[ -f $receipts/raw/compat-node.cases.jsonl ]]; then
  merge_args+=(--receipts "$receipts/raw/compat-node.cases.jsonl" "$work")
fi
for name in "${browser_names[@]}"; do
  # An invocation that wrote no receipts leaves its files unrun, which policy reports.
  if [[ -f $receipts/raw/$name.cases.jsonl ]]; then
    merge_args+=(--receipts "$receipts/raw/$name.cases.jsonl" "$work")
  fi
done
step cases "$run/python/scripts/ci/merge_cases.py" --sha "$sha" --seed "$seed" --out "$receipts/cases.jsonl" "${merge_args[@]}"
# Ratchets may only fall: compare with the target branch's budgets when it has them.
policy_args=()
if [[ -n ${target_tip:-} ]] && git cat-file -e "$target_tip:tests/budgets.toml" 2>/dev/null; then
  git show "$target_tip:tests/budgets.toml" > "$receipts/base-budgets.toml"
  policy_args=(--base-budgets "$receipts/base-budgets.toml")
fi
step policy "$run/python/scripts/ci/policy.py" --root "$run/python" --cases "$receipts/cases.jsonl" "${policy_args[@]}"

cat "$receipts"/steps/*.tsv > "$receipts/steps.tsv"
# Missing/truncated receipts or skipped/nonzero steps can never produce PASS.
if ! awk -F '\t' -v expected="$((browser_steps + 12))" '
  NF != 3 || $2 != "0" || $3 !~ /^[0-9]+$/ { bad=1 }
  END { exit (bad || NR != expected) }
' "$receipts/steps.tsv"; then failed=1; fi
if ((failed)); then
  # Keep the browser evidence: traces, screenshots, reports and auth files.
  if [[ -d $run/browser-results ]]; then
    mkdir -p "$receipts/test-results"
    cp -a "$run/browser-results/." "$receipts/test-results/"
  fi
fi
printf 'finished\t%s\n' "$(date -u +%FT%TZ)" >> "$receipts/run.tsv"
column -t "$receipts/steps.tsv"
if ((failed)); then
  keep_run=1
  echo "ci-local FAILED for $sha; receipts: $receipts"
  exit 1
fi
echo "$sha" > "$receipts/PASS"
echo "ci-local PASSED for $sha; receipts: $receipts"
cd "$repo"
((signoff)) || exit 0

# Recheck what can move during a run, post the status to the tested SHA by
# name (not to whatever the checkout holds now), and only then finalize the
# receipt: an interrupted or failed post leaves no signoff receipt.
final_tip=$(remote_tip) || refuse "cannot reread refs/heads/$target from origin"
[[ $final_tip == "$target_tip" ]] ||
  refuse "origin/$target moved from $target_tip to $final_tip during the run; rebuild the merge candidate"
head_now=$(git rev-parse HEAD)
[[ $head_now == "$sha" ]] || refuse "the checkout moved from $sha to $head_now during the run"
check_nightly_red
user=$(git config user.name) || refuse "git user.name is not set"
chromium=$(cd "$work/web" && node -e 'console.log(require("playwright-core").chromium.executablePath())')
receipt=$receipts/signoff-$sha.tsv
{
  printf 'sha\t%s\ntree\t%s\ntarget\t%s\ntarget_tip\t%s\nseed\t%s\n' "$sha" "$tree" "$target" "$target_tip" "$seed"
  printf 'started\t%s\nfinished\t%s\n' "$started" "$(date -u +%FT%TZ)"
  printf 'steps\t%s\n' "$(cut -f1 "$receipts/steps.tsv" | sort | paste -sd, -)"
  printf 'policy\t%s\n' "$(tail -n 1 "$receipts/logs/policy.log")"
  printf 'nightly_red_closed\t%s\n' "${closes_nightly_red:-none}"
  printf 'python_fresh\t%s\n' "$("$run/fresh/.ci-fresh-venv/bin/python" --version)"
  printf 'python_e2e\t%s\n' "$("$work/venv/bin/python" --version)"
  printf 'node\t%s\n' "$(node --version)"
  printf 'chromium\t%s\n' "$("$chromium" --version)"
  printf 'ffmpeg\t%s\n' "$(ffmpeg -version | head -n 1)"
} > "$receipt.partial"
# The same status `gh signoff create` posts, bound to $sha.
status_url=$(gh api --method POST "repos/{owner}/{repo}/statuses/$sha" -f state=success \
  -f context=signoff -f "description=$user signed off" --jq .url) ||
  refuse "GitHub did not accept the signoff status for $sha"
[[ $status_url == */statuses/"$sha" ]] || refuse "GitHub recorded the status at $status_url, not on $sha"
printf 'posted\t%s\nstatus_url\t%s\n' "$(date -u +%FT%TZ)" "$status_url" >> "$receipt.partial"
mv "$receipt.partial" "$receipt"
echo "signoff posted for $sha; receipt: $receipt"
