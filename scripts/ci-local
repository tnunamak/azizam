#!/usr/bin/env bash
# Run every CI job on an exact commit and retain per-step receipts.
# Usage: scripts/ci-local [--signoff] [--force] [--port N] [--shards N] [--py-workers N] [--skip-compose]
# Independent jobs and browser fixtures run in isolated detached worktrees.
# A passed tree is not rerun unless --force is given. See docs/ops/CI.md.
set -euo pipefail
[[ -n ${AZIZAM_PRIORITY_SET:-} ]] || exec "${BASH_SOURCE[0]%/*}/low-priority" "${BASH_SOURCE[0]}" "$@"

signoff=0 force=0 port=18640 shards=10 py_workers=12 skip_compose=0
while (($#)); do
  case $1 in
    --signoff) signoff=1 ;;
    --force) force=1 ;;
    --port|--shards|--py-workers)
      (($# >= 2)) || { echo "$1 requires a number" >&2; exit 2; }
      case $1 in --port) port=$2 ;; --shards) shards=$2 ;; *) py_workers=$2 ;; esac
      shift ;;
    --skip-compose) skip_compose=1 ;;
    -h|--help) sed -n '2,5p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done
# Each ten-port lane owns gateway +0, engine +1, strict probes +2..+9.
# Bound inputs before arithmetic, including the two additional fixture lanes.
if [[ ! $port =~ ^18[0-9]{3}$ || ! $shards =~ ^[1-9][0-9]?$ || ! $py_workers =~ ^[1-9][0-9]?$ ]]; then
  echo "--port must be 18000-18998 and --shards and --py-workers positive integers <= 99" >&2
  exit 2
fi
if ((port + 10 * (shards + 2) + 9 > 18998)); then
  echo "shards, live-data and household lanes must fit within 18000-18998" >&2
  exit 2
fi
command -v setsid >/dev/null || { echo "ci-local requires setsid" >&2; exit 2; }

repo=$(git rev-parse --show-toplevel)
cd "$repo"
if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
  echo "ci-local runs on HEAD: commit or stash tracked changes first" >&2
  exit 2
fi
sha=$(git rev-parse HEAD)
tree=$(git rev-parse 'HEAD^{tree}')
receipts_root=${AZIZAM_CI_RECEIPTS:-$HOME/.tmp/azizam-ci-receipts}
receipts=$receipts_root/$tree
sign() {
  ((signoff)) || return 0
  gh signoff create
  echo "signoff posted for $sha"
}
if [[ -f $receipts/PASS && $force == 0 ]]; then
  echo "tree $tree already passed (receipts: $receipts)"
  sign
  exit 0
fi

scratch=${AZIZAM_CI_SCRATCH:-$HOME/.tmp}
mkdir -p "$scratch" "$receipts/logs"
receipts=$(cd "$receipts" && pwd)
rm -f "$receipts/PASS" "$receipts/steps.tsv"
rm -rf "$receipts/steps" "$receipts/test-results"
mkdir -p "$receipts/steps"
run=$(mktemp -d "$scratch/azizam-ci-local.XXXXXXXX")
run=$(cd "$run" && pwd)
work=$run/web-build
worktrees=()
pids=()
lane_pids=()
cleanup() {
  local pid directory deadline=$((SECONDS + 20))
  trap '' INT TERM
  # Every background job has its own session: never kill the caller's group.
  for pid in "${pids[@]}"; do kill -TERM -- "-$pid" 2>/dev/null || true; done
  for pid in "${pids[@]}"; do
    while kill -0 -- "-$pid" 2>/dev/null && ((SECONDS < deadline)); do sleep .2; done
    kill -KILL -- "-$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
  # Playwright starts each fixture server in its own session, so group kills
  # miss them; stop anything still running from this run's directory.
  pkill -TERM -f -- "$run/" 2>/dev/null || true
  deadline=$((SECONDS + 10))
  while pgrep -f -- "$run/" >/dev/null 2>&1 && ((SECONDS < deadline)); do sleep .2; done
  pkill -KILL -f -- "$run/" 2>/dev/null || true
  cd "$repo"
  for directory in "${worktrees[@]}"; do
    git worktree remove --force "$directory" >/dev/null 2>&1 || true
  done
  rm -rf "$run"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
add_worktree() {
  worktrees+=("$1")
  git -C "$repo" worktree add --quiet --detach "$1" "$sha"
}
add_worktree "$work"
add_worktree "$run/python"
add_worktree "$run/fresh"
printf 'sha\t%s\ntree\t%s\nstarted\t%s\nshards\t%s\npy_workers\t%s\nbase_port\t%s\n' "$sha" "$tree" "$(date -u +%FT%TZ)" "$shards" "$py_workers" "$port" > "$receipts/run.tsv"

failed=0
step() {
  local name=$1; shift
  local start=$SECONDS rc=0
  echo "== $name"
  # Run in the background and wait: a trapped INT or TERM interrupts wait at
  # once, while a foreground child would make bash defer or drop the signal.
  ( "$@" ) > "$receipts/logs/$name.log" 2>&1 &
  wait "$!" || rc=$?
  # One writer per file; aggregation happens only after every job is reaped.
  printf '%s\t%s\t%s\n' "$name" "$rc" "$((SECONDS - start))" > "$receipts/steps/$name.tsv"
  if ((rc)); then failed=1; echo "   FAILED (exit $rc): $receipts/logs/$name.log"; fi
  return 0
}
export receipts work skip_compose py_workers run shards
export -f step
start_job() {
  local directory=$1; shift
  setsid bash -c 'cd "$1" || exit; shift; "$@"' _ "$directory" "$@" &
  last_pid=$!
  pids+=("$last_pid")
}
wait_job() {
  local pid=$1 index deadline
  if ! wait "$pid"; then failed=1; fi
  # A failed supervisor must not leave fixture grandchildren running.
  if kill -0 -- "-$pid" 2>/dev/null; then
    failed=1
    kill -TERM -- "-$pid" 2>/dev/null || true
    deadline=$((SECONDS + 20))
    while kill -0 -- "-$pid" 2>/dev/null && ((SECONDS < deadline)); do sleep .2; done
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  # Remove reaped groups before cleanup, avoiding stale PID signalling.
  for index in "${!pids[@]}"; do
    if [[ ${pids[index]} == "$pid" ]]; then unset 'pids[index]'; break; fi
  done
}

# These jobs never share their venv, generated files or node_modules.
start_job "$run/python" bash -c '
  failed=0
  step python-hermetic scripts/run-hermetic-pytest.sh -q -rsx -n "$py_workers" --dist worksteal
  exit "$failed"
'
# The Compose journey creates and removes a Docker bridge network. Chromium
# aborts in-flight requests on any host network change (ERR_NETWORK_CHANGED),
# so Compose must never overlap the browser lanes: it runs here, alongside web
# preparation, and the lanes start only after it finishes. The native journey
# runs later, beside the lanes: it needs no Docker network, and running it
# after Compose keeps the two from racing for the same free ports.
start_job "$run/fresh" bash -c '
  failed=0
  step fresh-venv bash -c "uv venv -q --python 3.12.13 .ci-fresh-venv && uv pip sync -q --no-build --strict --require-hashes --link-mode copy --python .ci-fresh-venv/bin/python tests/requirements-hermetic.lock"
  if ((skip_compose)); then
    printf "fresh-compose\tskipped\t0\n" > "$receipts/steps/fresh-compose.tsv"
    failed=1
    echo "== fresh-compose SKIPPED: the run cannot pass without it"
  else
    step fresh-compose env FRESH_INSTANCE_PYTHON="$PWD/.ci-fresh-venv/bin/python" scripts/e2e/fresh_instance.sh --compose
  fi
  exit "$failed"
'
fresh_pid=$last_pid
start_job "$work" bash -c '
  failed=0
  step web-npm-ci bash -c "cd web && npm ci --no-audit --no-fund"
  # Unit tests run beside the build, not beside the browser lanes: there, CPU
  # contention pushed tests past the 5 s vitest limit. They finish before the
  # lanes copy this tree.
  ( step web-unit bash -c "cd web && npx vitest run"; exit "$failed" ) &
  unit_pid=$!
  step web-check bash -c "cd web && npm run check"
  wait "$unit_pid" || failed=1
  step e2e-venv bash -c "uv venv -q --python 3.12 venv && uv pip sync -q --python venv/bin/python --require-hashes tests/requirements-hermetic.lock"
  step e2e-browser bash -c "cd web && npx playwright install chromium"
  # Split spec files by measured time; --shard splits by test count, which
  # left one of 12 lanes running 414 s and another 18 s.
  step e2e-plan bash -c "cd web && ./node_modules/.bin/playwright test --list > \"\$1/e2e-list.txt\" && ../scripts/e2e/plan_shards.py plan \"\$1/e2e-list.txt\" e2e/shard-weights.tsv \"\$2\" \"\$1/shards\"" _ "$run" "$shards"
  exit "$failed"
'
web_pid=$last_pid
wait_job "$web_pid"
wait_job "$fresh_pid"

# Browser lanes test the built export with the e2e venv and browser. Without
# them every journey fails with misleading 401/404s, so skip the lanes and
# let the failed prerequisite be the reported cause.
lanes=$((shards + 2))  # browser shards, live-data and household
browser_ready=1
for prerequisite in web-npm-ci web-check e2e-venv e2e-browser e2e-plan; do
  rc=$(cut -f2 "$receipts/steps/$prerequisite.tsv" 2>/dev/null || echo missing)
  if [[ $rc != 0 ]]; then browser_ready=0; fi
done
if ((!browser_ready)); then
  failed=1
  echo "== browser lanes skipped: a web build prerequisite failed (see above)"
  lanes=0
fi

# Copy the completed web tree, including dependencies and build output, only
# after all writers stop. Reflinks save space where supported; ordinary copies
# still isolate writable caches and legacy fixed screenshot/auth filenames.
for ((i=1; i<=lanes; i++)); do
  lane_port=$((port + 10 * i))
  lane=$run/browser-$lane_port
  add_worktree "$lane"
  # node_modules is read-only during the journeys: hard-link it (no disk cost)
  # and copy everything else so writable caches and results stay per lane.
  step "e2e-copy-$lane_port" bash -c 'shopt -s dotglob; for entry in "$1"/web/*; do
    if [[ $(basename "$entry") == node_modules ]]; then cp -al "$entry" "$2/web/"; else cp -a --reflink=auto "$entry" "$2/web/"; fi
  done' _ "$work" "$lane"
  ln -s "$work/venv" "$lane/venv"
done
for ((i=1; i<=lanes; i++)); do
  lane_port=$((port + 10 * i))
  lane=$run/browser-$lane_port
  config=playwright.config.ts
  args=()
  name=e2e-shard-$i-of-$shards
  if ((i <= shards)); then
    args+=(--test-list "$run/shards/lane-$i.txt")
  elif ((i == shards + 1)); then
    config=playwright.live-data.config.ts; name=e2e-live-data
  else
    config=playwright.household.config.ts; name=e2e-household
  fi
  start_job "$lane/web" bash -c '
    failed=0
    name=$1; shift
    step "$name" "$@"
    exit "$failed"
  ' _ "$name" env UI_E2E_PORT="$lane_port" UI_E2E_STATE_ROOT="$lane/.ui-e2e-state" UI_E2E_PYTHON="$work/venv/bin/python" ./node_modules/.bin/playwright test --config "$config" "${args[@]}"
  lane_pids+=("$last_pid")
done
start_job "$run/fresh" bash -c '
  failed=0
  step fresh-native env FRESH_INSTANCE_PYTHON="$PWD/.ci-fresh-venv/bin/python" scripts/e2e/fresh_instance.sh
  exit "$failed"
'
for pid in "${pids[@]}"; do wait_job "$pid"; done

cat "$receipts"/steps/*.tsv > "$receipts/steps.tsv"
# Missing/truncated receipts or skipped/nonzero steps can never produce PASS.
if ! awk -F '\t' -v expected="$((2 * lanes + 10))" '
  NF != 3 || $2 != "0" || $3 !~ /^[0-9]+$/ { bad=1 }
  END { exit (bad || NR != expected) }
' "$receipts/steps.tsv"; then failed=1; fi
if ((failed)); then
  # Keep each lane's complete evidence, including legacy fixed filenames.
  for ((i=1; i<=lanes; i++)); do
    lane_port=$((port + 10 * i))
    if [[ -d $run/browser-$lane_port/web/test-results ]]; then
      mkdir -p "$receipts/test-results/$lane_port"
      cp -a "$run/browser-$lane_port/web/test-results/." "$receipts/test-results/$lane_port/"
    fi
  done
fi
printf 'finished\t%s\n' "$(date -u +%FT%TZ)" >> "$receipts/run.tsv"
column -t "$receipts/steps.tsv"
if ((failed)); then
  echo "ci-local FAILED for $sha; receipts: $receipts"
  exit 1
fi
echo "$sha" > "$receipts/PASS"
echo "ci-local PASSED for $sha; receipts: $receipts"
cd "$repo"
sign
