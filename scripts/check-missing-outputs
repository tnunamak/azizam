#!/usr/bin/env python3
"""Count missing successful-job outputs in a checkpointed SQLite snapshot.

Never changes stores or prints identifiers. Refuses an active WAL rather than
silently omitting it or letting SQLite create sidecars beside an operator store.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sqlite3
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from gateway import directory_index


def inventory(database: Path, media_dir: Path) -> dict:
    def signature():
        wal = database.with_name(database.name + "-wal")
        if wal.exists() and wal.stat().st_size:
            raise ValueError("nonempty WAL; use a checkpointed snapshot")
        stat = database.stat()
        return stat.st_dev, stat.st_ino, stat.st_mtime_ns, stat.st_size

    before = signature()
    digests = {digest for path in media_dir.iterdir() if path.is_file()
               if (digest := directory_index.stored_digest(path.name)) is not None}
    counts = {kind: {"jobs": 0, "outputs": 0} for kind in ("image", "audio", "video")}
    successful_jobs = 0
    invalid_assets = 0
    with sqlite3.connect(database.resolve().as_uri() + "?mode=ro&immutable=1", uri=True) as conn:
        for (raw,) in conn.execute("SELECT job_json FROM media_jobs WHERE status = 'succeeded'"):
            successful_jobs += 1
            job = json.loads(raw)
            missing_kinds = set()
            for asset in job.get("assets") or []:
                aid = asset.get("asset_id") or asset.get("id") if isinstance(asset, dict) else None
                prefix, _, digest = aid.partition("_") if isinstance(aid, str) else ("", "", "")
                kind = {"img": "image", "aud": "audio", "vid": "video"}.get(prefix)
                if kind is None or len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest):
                    invalid_assets += 1
                elif digest not in digests:
                    counts[kind]["outputs"] += 1
                    missing_kinds.add(kind)
            for kind in missing_kinds:
                counts[kind]["jobs"] += 1
    if signature() != before:
        raise ValueError("database changed; use a stable snapshot")
    return {"successful_jobs": successful_jobs, "missing_outputs": counts, "invalid_assets": invalid_assets}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--database", type=Path, required=True)
    parser.add_argument("--media-dir", type=Path, required=True)
    args = parser.parse_args()
    try:
        report = inventory(args.database, args.media_dir)
    except (OSError, sqlite3.Error, ValueError, TypeError, AttributeError) as exc:
        print(json.dumps({"error": "consistency_check_unavailable", "type": type(exc).__name__}), file=sys.stderr)
        return 1
    print(json.dumps(report, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
