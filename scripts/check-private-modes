#!/usr/bin/env python3
"""Report or repair modes below private data roots without listing filenames."""
from __future__ import annotations

import argparse
import os
import stat
from pathlib import Path


def inspect(root: Path, *, fix: bool) -> tuple[int, int, int]:
    """Return (files, directories, violations); never follow or report symlinks."""
    files = directories = violations = 0
    if not root.exists() or root.is_symlink() or not root.is_dir():
        return files, directories, violations
    stack = [root]
    while stack:
        directory = stack.pop()
        info = directory.lstat()
        directories += 1
        if stat.S_IMODE(info.st_mode) != 0o700:
            violations += 1
            if fix:
                os.chmod(directory, 0o700, follow_symlinks=False)
        try:
            entries = list(os.scandir(directory))
        except OSError:
            violations += 1
            continue
        for entry in entries:
            try:
                child_info = entry.stat(follow_symlinks=False)
            except OSError:
                violations += 1
                continue
            if stat.S_ISDIR(child_info.st_mode):
                stack.append(Path(entry.path))
            elif stat.S_ISREG(child_info.st_mode):
                files += 1
                if stat.S_IMODE(child_info.st_mode) != 0o600:
                    violations += 1
                    if fix:
                        os.chmod(entry.path, 0o600, follow_symlinks=False)
    return files, directories, violations


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--fix", action="store_true", help="set regular files to 0600 and directories to 0700")
    args = parser.parse_args(argv)

    failed = False
    for label in ("data", "cache/images"):
        target = args.root / label
        files, directories, violations = inspect(target, fix=args.fix)
        if not target.exists():
            continue
        action = "repaired" if args.fix else "need repair"
        print(f"{label}: {files} files, {directories} directories, {violations} mode issues ({action})")
        failed |= violations > 0
    return 1 if failed and not args.fix else 0


if __name__ == "__main__":
    raise SystemExit(main())
