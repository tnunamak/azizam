LTX_SIZE = "768x448"


def _video_save(c, ex_id, card, alias, resolves, s, body_prompt, content, inputs, order=0, title=None, chips=None, extra_files=None):
    files = {"output.mp4": content, **(extra_files or {})}
    c.save({"id": ex_id, "card": card, "order": order, "title": title, "seconds": s, "model": alias, "resolves_to": resolves, "chips": chips or [],
            "inputs": inputs, "outputs": [{"kind": "video", "file": "output.mp4"}]}, files)


