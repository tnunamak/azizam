            "inputs": [{"kind": "text", "label": "Prompt", "name": "prompt", "value": prompt}], "outputs": [{"kind": "image", "file": "output.png"}]}, {"output.png": b64_image(r)})


# ---- edits (use the krea lighthouse image as the source)

def _edit(ex_id, card, alias, prompt, group="edits", extra_files=None, order=0, ext=None, title=None, extra_inputs=None, source=("image-krea2-turbo", "output.png")):
    @example(ex_id, group, card)
    def _(c: Ctx):
        src = c.read(*source)
        files = {"image": ("source.png", src, "image/png")}
        files.update({k: (k + ".png", v(c) if callable(v) else v, "image/png") for k, v in (extra_files or {}).items()})
        data = {"model": alias, "prompt": prompt, "response_format": "b64_json"}
        if ext:
            data["extensions"] = json.dumps({"com.azizam.workflow": ext})
        r, s = timed(lambda: c.gw.json("POST", "/v1/images/edits", data=data, files=files))
        out_files = {"source.png": src, "output.png": b64_image(r)}
        inputs = [{"kind": "image", "label": "Source image", "name": "source_image", "file": "source.png", "type": "image/png"}]
        for k, v in (extra_files or {}).items():
            out_files[k + ".png"] = files[k][1]
            inputs.append({"kind": "image", "label": k.replace("_", " "), "name": k, "file": k + ".png", "type": "image/png"})
        inputs.append({"kind": "text", "label": "Instruction", "name": "prompt", "value": prompt})
        c.save({"id": ex_id, "card": card, "order": order, "title": title, "seconds": s, "model": alias, "resolves_to": c.gw.resolve("image_edits", alias),
                "inputs": inputs, "outputs": [{"kind": "image", "file": "output.png"}]}, out_files)


_edit("edit-qwen", "qwen-image-2.1-edit", "image-edit", "Change the scene to night time with a sky full of stars; keep the lighthouse.", title="Instruction edit")
_edit("edit-flux2", "flux2-klein-4b", "image-edit-fast", "Change the scene to night time with a sky full of stars; keep the lighthouse.", title="Fast edit (image-edit-fast)")
_edit("edit-qwen-inpaint", "qwen-image-2.1-inpaint", "qwen-image-2.1-inpaint", "A large white seagull flying in the sky.", extra_files={"mask": lambda c: make_mask_png((1024, 1024), (600, 100, 900, 350))}, title="Inpaint the masked box")
_edit("edit-flux2-inpaint", "flux2-klein-4b-inpaint", "flux2-klein-4b-inpaint", "A large white seagull flying in the sky.", extra_files={"mask": lambda c: make_mask_png((1024, 1024), (600, 100, 900, 350))}, title="Inpaint the masked box")
_edit("edit-multiref", "qwen-image-2.1-edit-multiref", "qwen-image-2.1-edit-multiref", "Add the red sailboat from the second image to the sea in the first image.", extra_files={"reference_image_2": lambda c: c.read("image-source-boat", "output.png")}, title="Two reference images")
