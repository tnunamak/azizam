# ---- audio generation

def _audio(ex_id, group, card, model, body, alias, ext=None, title=None, order=0, ext_ok=True):
    @example(ex_id, group, card)
    def _(c: Ctx):
        b = {"model": model, **body}
        if ext:
            b["extensions"] = {"com.azizam.workflow": ext}
        r, s = timed(lambda: c.gw.request("POST", "/v1/audio/generate", json=b))
        ctype = r.headers.get("content-type", "")
        suffix = "flac" if "flac" in ctype else "mp3" if "mpeg" in ctype else "wav"
        inputs = [{"kind": "text", "label": k.capitalize(), "name": k, "value": str(v)} for k, v in body.items() if k in ("prompt", "tags", "lyrics")]
        inputs += [{"kind": "text", "label": "Duration (s)", "name": "duration", "value": str(body["duration"])}] if "duration" in body else []
        c.save({"id": ex_id, "card": card, "order": order, "title": title, "seconds": s, "model": alias or model, "resolves_to": model,
                "inputs": inputs, "outputs": [{"kind": "audio", "file": f"output.{suffix}"}]}, {f"output.{suffix}": r.content})


_audio("sfx-sa3", "audio", "sa3-small-sfx", "sa3-small-sfx", {"prompt": "glass bottle breaking on concrete", "duration": 4, "seed": 7}, "sfx", title="Sound effect sample")
_audio("sfx-tangoflux", "audio", "tangoflux", "tangoflux", {"prompt": "short analog synth riser", "duration": 6, "seed": 7}, None, title="TangoFlux")
_audio("music-ace-xl", "audio", "ace-step-1.5-xl-turbo", "ace-step-1.5-xl-turbo", {"tags": "dream pop, warm piano, soft drums, mellow", "lyrics": "[instrumental]", "duration": 20, "seed": 1234}, "music", title="Instrumental music sample")
_audio("music-ace-2b", "audio", "ace-step-1.5-2b-base", "ace-step-1.5-2b-base", {"tags": "lofi hip hop, vinyl crackle, relaxed beat", "lyrics": "[instrumental]", "duration": 20, "seed": 1234}, None, title="ACE-Step 2B base")
_audio("song-yue2", "audio", "yue2-song", "yue2-song", {"tags": "indie folk pop, warm female vocals, fingerpicked acoustic guitar", "lyrics": "[Verse 1]\nMorning light on the window sill\nCoffee warm and the world is still\n\n[Chorus]\nRun with me into the sunlight\nEverything will be alright", "duration": 40, "seed": 42}, "song", title="Song sample")


