def _(c: Ctx):
    # A generated person walking, then a different generated character swapped in.
    prompt_src = "a person in a gray hoodie walks toward the camera along a bright sidewalk, waving"
    (src, _j), _s = timed(lambda: c.gw.video({"model": "video", "prompt": prompt_src, "seconds": 4, "size": LTX_SIZE, "seed": 21}))
    ref_prompt = "full body illustration of a friendly woman in a bright red raincoat, standing, plain light background"
    ref = b64_image(c.gw.json("POST", "/v1/images/generations", json={"model": "image", "prompt": ref_prompt, "size": "768x768", "response_format": "b64_json"}))
    prompt = "A young woman in a bright red raincoat walks toward the camera, waving."
    ext = {"source_video": data_uri(src, "video/mp4"), "reference_image": data_uri(ref, "image/png"), "source_subject": "person", "reference_subject": "woman"}
    (content, job), s = timed(lambda: c.gw.video({"model": "character-replace", "prompt": prompt, "extensions": {"com.azizam.workflow": ext}}, poll_s=8))
    _video_save(c, "video-character-replace", "scail-2-replace", "character-replace", "video-scail-2-replace", s, prompt, content,
                [{"kind": "video", "label": "Driving video (generated)", "name": "source_video", "file": "source.mp4", "type": "video/mp4"}, {"kind": "image", "label": "Reference character (generated)", "name": "reference_image", "file": "reference.png", "type": "image/png"}, {"kind": "text", "label": "Prompt", "name": "prompt", "value": prompt}],
                title="Swap the character", extra_files={"source.mp4": src, "reference.png": ref})


# ------------------------------------------------------------------------- driver

def select(only: list[str] | None, groups: list[str] | None) -> list[dict[str, Any]]:
    chosen = [e for e in EXAMPLES if (not only or e["id"] in only) and (not groups or e["group"] in groups)]
    chosen.sort(key=lambda e: GROUP_ORDER.index(e["group"]))  # stable: keeps declaration order within a group
    return chosen


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--base", default=os.environ.get("SHOWCASE_BASE_URL", "http://127.0.0.1:5000"))
    ap.add_argument("--out", default=get_env("AZIZAM_SHOWCASE_EXAMPLES_DIR") or str(REPO / "data" / "showcase" / "examples"))
    ap.add_argument("--comfy", default="http://127.0.0.1:7890")
    ap.add_argument("--llm", default="http://127.0.0.1:5051")
    ap.add_argument("--only", help="comma-separated example ids")
    ap.add_argument("--groups", help="comma-separated: " + ",".join(GROUP_ORDER))
    ap.add_argument("--force", help="comma-separated example ids to redo")
    ap.add_argument("--idle-minutes", type=float, default=10)
    ap.add_argument("--no-idle-check", action="store_true", help="skip the GPU etiquette guard (CPU-only or private hosts)")
    ap.add_argument("--list", action="store_true")
    args = ap.parse_args(argv)

    out = Path(args.out)
    force = set(filter(None, (args.force or "").split(",")))
    todo = select(args.only.split(",") if args.only else None, args.groups.split(",") if args.groups else None)
    def is_done(ex_id: str) -> bool:
        return (out / ex_id / "example.json").is_file()

    if args.list:
        for e in todo:
            print(f"{e['group']:7} {e['id']:28} {e['card']:30} {'done' if is_done(e['id']) else 'pending'}")
        return 0

    def log(msg: str) -> None:
        print(time.strftime("%H:%M:%S"), msg, flush=True)

    guard = IdleGuard(args.comfy, args.llm, args.idle_minutes, not args.no_idle_check, log)
    gw = Gateway(args.base, guard=guard)
    ctx = Ctx(gw, out)
    failures: list[str] = []
    for e in todo:
        if is_done(e["id"]) and e["id"] not in force:
            log(f"skip {e['id']} (present)")
            continue
        guard.wait(e["id"])
        ctx.group = e["group"]
        ctx.started_at = time.monotonic()
        gw.recorded_requests = []
        log(f"run  {e['id']} [{e['group']}]")
        try:
            e["fn"](ctx)
            log(f"ok   {e['id']}")
        except Exception as exc:  # noqa: BLE001
            failures.append(e["id"])
            log(f"FAIL {e['id']}: {str(exc)[:300]}")
    log(f"finished; failures: {failures or 'none'}")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
