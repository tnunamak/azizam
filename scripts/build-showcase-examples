#!/usr/bin/env python3
"""Record the curated /showcase examples by calling the live gateway.

Each example becomes ``<out>/<id>/example.json`` plus its input and output
media. The script is idempotent: an example whose ``example.json`` exists is
skipped (``--force ID`` redoes one). Prompts are benign and generic; inputs
are synthetic or generated by the gateway itself. No personal photos.

GPU etiquette. The GPU also serves a live agent, so every job waits for an
idle window first:

  * the Daisy tmux pane prints no "Working" (``tmux capture-pane``),
  * the ComfyUI queue is empty, and
  * the llama.cpp server reports no ``is_processing`` slot.

The first job needs the window to hold for ``--idle-minutes`` (default 10).
Every later job needs the check to pass right then, and the script pauses
while anything is busy. Jobs run cheap first (embeddings, speech, chat,
small images), then audio generation, then video last.

Usage:
  scripts/build-showcase-examples --list
  scripts/build-showcase-examples --groups cheap,images
  scripts/build-showcase-examples --only tts-fast,sfx-sa3
  scripts/build-showcase-examples --no-idle-check --only embeddings   # CPU only
"""

from __future__ import annotations

import sys as _compat_sys
from pathlib import Path as _CompatPath
_compat_sys.path.insert(0, str(_CompatPath(__file__).resolve().parents[1]))
from gateway.compat import get_env

import argparse
import base64
import hashlib
from datetime import datetime, timezone
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Callable

import httpx

REPO = Path(__file__).resolve().parent.parent
GROUP_ORDER = ["cheap", "images", "edits", "audio", "video"]

SKY_PROMPT = "a watercolor painting of a lighthouse on a rocky coast at sunrise, soft pastel colors"
SPEECH_TEXT = "The quick brown fox jumps over the lazy dog, then naps in the afternoon sun."


# --------------------------------------------------------------------- idle guard

def tmux_working_count(target: str = "main:daisy") -> int | None:
    """Count of 'Working' lines in the Daisy pane; None when tmux has no such pane."""
    try:
        out = subprocess.run(
            ["tmux", "capture-pane", "-p", "-t", target],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    return sum(1 for line in out.stdout.splitlines() if "Working" in line)


def idle_reasons(
    *,
    working: int | None,
    comfy_queue: dict | None,
    llm_slots: list | None,
) -> list[str]:
    """Why the GPU is not idle; an empty list means idle.

    An unreadable probe counts as busy for ComfyUI and the LLM (we cannot
    prove they are idle). A missing tmux pane counts as idle: no agent there.
    """
    reasons: list[str] = []
    if working:
        reasons.append(f"daisy pane shows {working} 'Working' line(s)")
    if comfy_queue is None:
        reasons.append("ComfyUI queue unreadable")
    elif comfy_queue.get("queue_running") or comfy_queue.get("queue_pending"):
        reasons.append("ComfyUI queue not empty")
    if llm_slots is None:
        reasons.append("LLM slots unreadable")
    elif any(isinstance(s, dict) and s.get("is_processing") for s in llm_slots):
        reasons.append("LLM is processing")
    return reasons


class IdleGuard:
    def __init__(self, comfy: str, llm: str, minutes: float, enabled: bool, log: Callable[[str], None]):
        self.comfy, self.llm, self.minutes = comfy, llm, minutes
        self.enabled, self.log = enabled, log
        self.window_proven = False

    def _probe(self, url: str) -> Any:
        try:
            r = httpx.get(url, timeout=3)
            return r.json() if r.status_code == 200 else None
        except Exception:  # noqa: BLE001
            return None

    def reasons(self) -> list[str]:
        return idle_reasons(
            working=tmux_working_count(),
            comfy_queue=self._probe(self.comfy + "/queue"),
            llm_slots=self._probe(self.llm + "/slots"),
        )

    def wait(self, what: str) -> None:
        """Block until the GPU is idle (and, the first time, idle for N minutes)."""
        if not self.enabled:
            return
        need = self.minutes * 60 if not self.window_proven else 0
        idle_since: float | None = None
        announced = False
        while True:
            why = self.reasons()
            now = time.monotonic()
            if why:
                idle_since = None
                if not announced:
                    self.log(f"  pause before {what}: {'; '.join(why)}")
                    announced = True
            else:
                idle_since = idle_since or now
                if now - idle_since >= need:
                    self.window_proven = True
                    return
            time.sleep(15)


# ------------------------------------------------------------------------ client

class Gateway:
    def __init__(self, base: str, guard: IdleGuard | None = None):
        self.base = base.rstrip("/")
        self.guard = guard
        self.recorded_requests: list[dict] = []
        key = get_env("AZIZAM_API_KEY")
        self.headers = {"Authorization": f"Bearer {key}"} if key else {}
        self.http = httpx.Client(timeout=httpx.Timeout(1800, connect=10), headers=self.headers)

    def request(self, method: str, path: str, **kw: Any) -> httpx.Response:
        if method.upper() == "POST":
            # The idle wait and catalog lookups are bookkeeping, not the request:
            # timed() subtracts them so a published run time measures the request.
            prep_started = time.monotonic()
            if self.guard is not None:
                self.guard.wait(path)
            body = kw.get("json", kw.get("data", {}))
            model = body.get("model") if isinstance(body, dict) else None
            operation = {
                "/v1/embeddings": "embeddings", "/v1/audio/speech": "speech",
                "/v1/audio/transcriptions": "transcriptions",
                "/v1/chat/completions": "chat", "/v1/responses": "chat",
                "/anthropic/v1/messages": "chat", "/ollama/api/chat": "chat",
                "/v1/images/generations": "images", "/v1/images/edits": "image_edits",
            }.get(path)
            resolved = self.resolve(operation, model) if operation and model else None
            display_name = self.display_name(resolved or model)
            request = {
                "method": "POST", "path": path, "body": public_input(body),
                "requested_model": model, "resolved_model": resolved,
                "model_display_name": display_name,
                "model_display_name_status": "catalog" if display_name else "UNVERIFIED",
            }
            request["files"] = {
                field: {"filename": value[0], "sha256": hashlib.sha256(value[1]).hexdigest(),
                        "content_type": value[2]}
                for field, value in kw.get("files", {}).items()
            }
            self.recorded_requests.append(request)
            _UNTIMED[0] += time.monotonic() - prep_started
        r = self.http.request(method, self.base + path, **kw)
        if r.status_code >= 400:
            raise RuntimeError(f"{method} {path} -> {r.status_code}: {r.text[:400]}")
        return r

    def json(self, method: str, path: str, **kw: Any) -> Any:
        return self.request(method, path, **kw).json()

    def display_name(self, model: str | None) -> str | None:
        """Copy only a display label from discovery; never invent one from an alias."""
        if not model:
            return None
        try:
            catalog = self.json("GET", "/v1/models")
            for item in catalog.get("data", []):
                if isinstance(item, dict) and item.get("id") == model:
                    name = item.get("display_name") or item.get("name")
                    return name if isinstance(name, str) and name.strip() else None
        except Exception:  # noqa: BLE001
            pass
        return None

    def resolve(self, operation: str, model: str) -> str | None:
        try:
            r = self.json("GET", "/gateway/v1/aliases/resolve", params={"operation": operation, "model": model})
        except Exception:  # noqa: BLE001
            return None
        return r.get("resolves_to") or r.get("resolved") if isinstance(r, dict) else None

    def video(self, body: dict, poll_s: float = 4) -> tuple[bytes, dict]:
        job = self.json("POST", "/v1/videos", json=body)
        vid = job["id"]
        while job.get("status") not in ("completed", "failed"):
            time.sleep(poll_s)
            job = self.json("GET", f"/v1/videos/{vid}")
        if job["status"] != "completed":
            raise RuntimeError(f"video failed: {job.get('error')}")
        return self.request("GET", f"/v1/videos/{vid}/content").content, job


# ---------------------------------------------------------------------- example io

def public_input(value: Any) -> Any:
    """Keep recipe inputs verbatim; represent inline media by its content hash.

    Capture request bodies only, never authentication headers, catalog objects,
    backend responses, job IDs, owner details or member history.
    """
    if isinstance(value, dict):
        return {k: public_input(v) for k, v in value.items()
                if k.lower() not in {"authorization", "api_key", "access_token",
                                     "password", "secret", "cookie", "token"}}
    if isinstance(value, list):
        return [public_input(v) for v in value]
    if isinstance(value, str) and value.startswith("data:") and ";base64," in value:
        header, data = value.split(",", 1)
        content = base64.b64decode(data, validate=True)
        return {"content_type": header[5:].split(";")[0],
                "sha256": hashlib.sha256(content).hexdigest()}
    return value


class Ctx:
    def __init__(self, gw: Gateway, out: Path):
        self.gw, self.out = gw, out
        self.group = ""
        self.started_at: float | None = None

    def path(self, ex_id: str, name: str) -> Path:
        return self.out / ex_id / name

    def read(self, ex_id: str, name: str) -> bytes:
        p = self.path(ex_id, name)
        if not p.is_file():
            raise FileNotFoundError(f"needs example '{ex_id}' ({name}); run it first")
        return p.read_bytes()

    def save(self, ex: dict, files: dict[str, bytes]) -> None:
        # Publish only the curated schema, not arbitrary backend metadata.
        ex = {k: v for k, v in ex.items() if k in {
            "id", "card", "order", "title", "seconds", "model",
            "chips", "inputs", "outputs",
        }}
        requests = list(self.gw.recorded_requests) if self.gw else []
        ex["requests"] = requests
        primary = requests[-1] if requests else {}
        ex["model"] = primary.get("requested_model") or ex.get("model")
        ex["resolves_to"] = primary.get("resolved_model")
        ex["model_display_name"] = primary.get("model_display_name")
        ex["model_display_name_status"] = primary.get("model_display_name_status", "UNVERIFIED")
        ex["seconds_scope"] = "timed request wall time, excluding idle waits and discovery lookups"
        ex["schema_version"] = 2
        ex["recorded_at"] = datetime.now(timezone.utc).isoformat()
        ex["wall_time_seconds"] = (
            round(time.monotonic() - self.started_at, 2) if self.started_at is not None else None
        )
        ex["wall_time_scope"] = "whole example, including input preparation, discovery and idle waits"
        ex["media_sha256"] = {name: hashlib.sha256(data).hexdigest() for name, data in files.items()}
        d = self.out / ex["id"]
        d.mkdir(parents=True, exist_ok=True)
        previous_media: set[str] = set()
        try:
            previous = json.loads((d / "example.json").read_text(encoding="utf-8"))
            for item in previous.get("inputs", []) + previous.get("outputs", []):
                name = item.get("file")
                if isinstance(name, str) and Path(name).name == name:
                    previous_media.add(name)
        except (OSError, ValueError, AttributeError, TypeError):
            pass
        for name, data in files.items():
            (d / name).write_bytes(data)
        ex["card"] = workflow_card_id(self.group, ex["card"])
        ex["created_at"] = int(time.time())
        tmp = d / "example.json.tmp"
        tmp.write_text(json.dumps(ex, indent=2), encoding="utf-8")
        tmp.replace(d / "example.json")  # example.json last: its presence marks success
        # A forced re-record must not leave old published voice samples accessible.
        for name in previous_media - files.keys() - {"example.json", "example.json.tmp"}:
            old = d / name
            if old.is_file():
                old.unlink()


def workflow_card_id(group: str, card: str) -> str:
    """Page card ids for workflow cards are full manifest ids (short ids collide
    across intents, e.g. flux2-klein-4b generate vs edit)."""
    if group == "images":
        return "image.generate." + card
    if group == "edits":
        return "image.edit." + card
    if group == "audio":
        return "audio.generate." + card
    if group == "video":
        edit = card.startswith(("rife", "bernini", "scail"))
        return ("video.edit." if edit else "video.generate.") + card
    return card


# Seconds spent in Gateway.request bookkeeping (idle waits, discovery lookups).
_UNTIMED = [0.0]


def timed(fn: Callable[[], Any]) -> tuple[Any, float]:
    t0, untimed0 = time.monotonic(), _UNTIMED[0]
    value = fn()
    return value, round(time.monotonic() - t0 - (_UNTIMED[0] - untimed0), 2)


# -------------------------------------------------------------------- synthetic input

def make_shapes_png() -> bytes:
    from io import BytesIO
    from PIL import Image, ImageDraw
    im = Image.new("RGB", (512, 320), "white")
    d = ImageDraw.Draw(im)
    d.ellipse((40, 60, 200, 220), fill=(220, 40, 40))
    d.rectangle((220, 70, 380, 230), fill=(40, 80, 220))
    d.polygon([(420, 230), (480, 90), (540, 230)], fill=(40, 170, 70))
    b = BytesIO()
    im.save(b, "PNG")
    return b.getvalue()


def make_mask_png(size: tuple[int, int], box: tuple[int, int, int, int]) -> bytes:
    """White = area to repaint, black = keep (the usual inpaint convention)."""
    from io import BytesIO
    from PIL import Image, ImageDraw
    im = Image.new("L", size, 0)
    ImageDraw.Draw(im).rectangle(box, fill=255)
    b = BytesIO()
    im.convert("RGB").save(b, "PNG")
    return b.getvalue()


def ffmpeg_concat_audio(parts: list[bytes], pad_s: float = 0.4) -> bytes:
    tmp = Path(os.environ.get("HOME", ".")) / ".tmp" / "showcase-concat"
    tmp.mkdir(parents=True, exist_ok=True)
    names = []
    try:
        return _concat(parts, pad_s, tmp, names)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def _concat(parts: list[bytes], pad_s: float, tmp: Path, names: list[Path]) -> bytes:
    for i, p in enumerate(parts):
        f = tmp / f"p{i}.mp3"
        f.write_bytes(p)
        names.append(f)
    inputs = sum((["-i", str(n)] for n in names), [])
    filt = "".join(f"[{i}:a]aresample=24000,apad=pad_dur={pad_s}[a{i}];" for i in range(len(names)))
    filt += "".join(f"[a{i}]" for i in range(len(names))) + f"concat=n={len(names)}:v=0:a=1[o]"
    out = tmp / "out.wav"
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", *inputs, "-filter_complex", filt, "-map", "[o]", str(out)], check=True)
    return out.read_bytes()


def to_wav(mp3: bytes) -> bytes:
    p = subprocess.run(["ffmpeg", "-loglevel", "error", "-i", "pipe:0", "-ar", "16000", "-ac", "1", "-f", "wav", "pipe:1"], input=mp3, capture_output=True, check=True)
    return p.stdout


def data_uri(data: bytes, mime: str) -> str:
    return f"data:{mime};base64,{base64.b64encode(data).decode()}"


def b64_image(resp: dict) -> bytes:
    return base64.b64decode(resp["data"][0]["b64_json"])


# ------------------------------------------------------------------------ examples
# Each example function takes Ctx and returns None after ctx.save(...).

EXAMPLES: list[dict[str, Any]] = []


def example(ex_id: str, group: str, card: str):
    def deco(fn):
        EXAMPLES.append({"id": ex_id, "group": group, "card": card, "fn": fn})
        return fn
    return deco


@example("embeddings-basic", "cheap", "embeddings")
def _(c: Ctx):
    texts = ["A cat sat on the mat.", "A kitten rested on the rug.", "Quarterly revenue grew 12 percent."]
    r, s = timed(lambda: c.gw.json("POST", "/v1/embeddings", json={"model": "embed", "input": texts}))
    vecs = [d["embedding"] for d in r["data"]]
    def cos(a, b):
        import math
        return sum(x * y for x, y in zip(a, b)) / (math.sqrt(sum(x * x for x in a)) * math.sqrt(sum(y * y for y in b)))
    lines = [f"{len(vecs)} vectors, {len(vecs[0])} dimensions", f"cos(1,2) = {cos(vecs[0], vecs[1]):.2f}  (similar sentences)", f"cos(1,3) = {cos(vecs[0], vecs[2]):.2f}  (unrelated)"]
    c.save({"id": "embeddings-basic", "card": "embeddings", "title": "Compare three sentence embeddings", "seconds": s, "model": "embed", "resolves_to": c.gw.resolve("embeddings", "embed"),
            "inputs": [{"kind": "text", "label": "Texts", "name": "text", "value": "\n".join(texts)}],
            "outputs": [{"kind": "text", "text": "\n".join(lines)}]}, {})


def _tts_example(tier: str, order: int):
    @example(f"tts-{tier}", "cheap", "tts")
    def _(c: Ctx, tier=tier):
        r, s = timed(lambda: c.gw.request("POST", "/v1/audio/speech", json={"model": tier, "voice": "alloy", "input": SPEECH_TEXT, "response_format": "mp3"}))
        c.save({"id": f"tts-{tier}", "card": "tts", "order": order, "title": f"Tier {tier}", "seconds": s, "model": tier, "resolves_to": c.gw.resolve("speech", tier),
                "chips": ["voice: alloy"],
                "inputs": [{"kind": "text", "label": "Text", "name": "text", "value": SPEECH_TEXT}],
                "outputs": [{"kind": "audio", "file": "speech.mp3"}]}, {"speech.mp3": r.content})


for _i, _t in enumerate(["tts", "tts-fast", "tts-quality"]):
    _tts_example(_t, _i)


@example("voices-gallery", "cheap", "voices")
def _(c: Ctx):
    # Do not enumerate /v1/voices: that catalog may contain members' custom voices.
    # Use only the two generic IDs already used by the synthetic dialogue.
    outs, inputs, files, total = [], [], {}, 0.0
    for vid in ("alloy", "onyx"):
        text = f"Hello, this is a sample of the {vid} voice."
        r, s = timed(lambda: c.gw.request("POST", "/v1/audio/speech", json={
            "model": "tts-fast", "voice": vid, "input": text, "response_format": "mp3"}))
        total += s
        files[f"{vid}.mp3"] = r.content
        inputs.append({"kind": "text", "label": f"Text for {vid}", "value": text})
        outs.append({"kind": "audio", "label": vid, "file": f"{vid}.mp3"})
    c.save({"id": "voices-gallery", "card": "voices", "title": "Two voice samples",
            "seconds": round(total, 2), "model": "tts-fast",
            "inputs": inputs, "outputs": outs}, files)


def _speech_input(c: Ctx) -> bytes:
    return to_wav(c.read("tts-tts-quality", "speech.mp3"))


for _i, _t in enumerate(["stt", "stt-fast", "stt-quality"]):
    def _make(tier=_t, order=_i):
        @example(f"stt-{tier}", "cheap", "stt")
        def _(c: Ctx):
            audio = _speech_input(c)
            r, s = timed(lambda: c.gw.json("POST", "/v1/audio/transcriptions", data={"model": tier, "response_format": "json"}, files={"file": ("speech.wav", audio, "audio/wav")}))
            c.save({"id": f"stt-{tier}", "card": "stt", "order": order, "title": f"Tier {tier}", "seconds": s, "model": tier, "resolves_to": c.gw.resolve("transcriptions", tier),
                    "inputs": [{"kind": "audio", "label": "Audio (the tts-quality example)", "name": "audio", "file": "input.wav", "type": "audio/wav"}],
                    "outputs": [{"kind": "text", "text": r.get("text", "")}]}, {"input.wav": audio})
    _make()


@example("stt-diarize", "cheap", "stt-diarize")
def _(c: Ctx):
    a = c.gw.request("POST", "/v1/audio/speech", json={"model": "tts-fast", "voice": "alloy", "input": "Did you finish the report before the meeting?", "response_format": "mp3"}).content
    b = c.gw.request("POST", "/v1/audio/speech", json={"model": "tts-fast", "voice": "onyx", "input": "Almost. I will send it right after lunch.", "response_format": "mp3"}).content
    audio = ffmpeg_concat_audio([a, b])
    r, s = timed(lambda: c.gw.json("POST", "/v1/audio/transcriptions", data={"model": "stt-diarize", "response_format": "diarized_json", "chunking_strategy": "auto"}, files={"file": ("dialogue.wav", audio, "audio/wav")}))
    text = "\n".join(f"Speaker {x.get('speaker')} [{x.get('start', 0):.1f}-{x.get('end', 0):.1f} s]: {x.get('text', '').strip()}" for x in r.get("segments", []))
    c.save({"id": "stt-diarize", "card": "stt-diarize", "title": "Transcribe a synthetic two-voice dialogue", "seconds": s, "model": "stt-diarize", "resolves_to": c.gw.resolve("transcriptions", "stt-diarize"),
            "inputs": [{"kind": "audio", "label": "Dialogue (alloy then onyx)", "name": "audio", "file": "dialogue.wav", "type": "audio/wav"}],
            "outputs": [{"kind": "text", "text": text}]}, {"dialogue.wav": audio})


def _clean_chat(msg: dict) -> str:
    return (msg.get("content") or "").strip()


for _i, (_alias, _prompt) in enumerate([("default", "Explain in two sentences why the sky is blue."), ("fast", "Give me three tips for writing a clear commit message.")]):
    def _make(alias=_alias, prompt=_prompt, order=_i):
        @example(f"chat-{alias}", "cheap", "chat")
        def _(c: Ctx):
            r, s = timed(lambda: c.gw.json("POST", "/v1/chat/completions", json={"model": alias, "messages": [{"role": "user", "content": prompt}], "max_tokens": 1200}))
            toks = (r.get("usage") or {}).get("completion_tokens")
            c.save({"id": f"chat-{alias}", "card": "chat", "order": order, "title": f"Alias {alias}", "seconds": s, "model": alias, "resolves_to": c.gw.resolve("chat", alias),
                    "chips": [f"{toks} tokens"] if toks else [],
                    "inputs": [{"kind": "text", "label": "Message", "name": "prompt", "value": prompt}],
                    "outputs": [{"kind": "text", "text": _clean_chat(r["choices"][0]["message"])}]}, {})
    _make()


@example("vision-shapes", "cheap", "vision")
def _(c: Ctx):
    img = make_shapes_png()
    q = "List the shapes in this image and their colors."
    r, s = timed(lambda: c.gw.json("POST", "/v1/chat/completions", json={"model": "vision", "max_tokens": 1200, "messages": [{"role": "user", "content": [{"type": "image_url", "image_url": {"url": data_uri(img, "image/png")}}, {"type": "text", "text": q}]}]}))
    c.save({"id": "vision-shapes", "card": "vision", "title": "Describe a synthetic image", "seconds": s, "model": "vision", "resolves_to": c.gw.resolve("chat", "vision"),
            "inputs": [{"kind": "image", "label": "Image (drawn for this demo)", "name": "image", "file": "input.png", "type": "image/png"}, {"kind": "text", "label": "Question", "name": "prompt", "value": q}],
            "outputs": [{"kind": "text", "text": _clean_chat(r["choices"][0]["message"])}]}, {"input.png": img})


PROTO_PROMPT = "Write one short sentence about a lighthouse at sunrise."


def _proto(ex_id, flavor, path, body, extract, headers=None, order=0):
    @example(ex_id, "cheap", f"protocol-{flavor}")
    def _(c: Ctx):
        r, s = timed(lambda: c.gw.json("POST", path, json=body, headers=headers or {}))
        c.save({"id": ex_id, "card": f"protocol-{flavor}", "title": f"POST {path}", "seconds": s, "model": body["model"],
                "inputs": [{"kind": "json", "label": "Request body", "value": body}],
                "outputs": [{"kind": "text", "label": "Text", "text": extract(r)}]}, {})


_proto("proto-openai", "openai", "/v1/chat/completions", {"model": "gpt-4o", "max_tokens": 600, "messages": [{"role": "user", "content": PROTO_PROMPT}]}, lambda r: _clean_chat(r["choices"][0]["message"]))
_proto("proto-responses", "responses", "/v1/responses", {"model": "gpt-5", "max_output_tokens": 600, "input": PROTO_PROMPT}, lambda r: "".join(ct.get("text", "") for o in r.get("output", []) if o.get("type") == "message" for ct in o.get("content", [])))
_proto("proto-anthropic", "anthropic", "/anthropic/v1/messages", {"model": "claude-sonnet-4", "max_tokens": 600, "messages": [{"role": "user", "content": PROTO_PROMPT}]}, lambda r: "".join(b.get("text", "") for b in r.get("content", []) if b.get("type") == "text"), {"anthropic-version": "2023-06-01"})
_proto("proto-ollama", "ollama", "/ollama/api/chat", {"model": "default", "stream": False, "messages": [{"role": "user", "content": PROTO_PROMPT}]}, lambda r: (r.get("message") or {}).get("content", "").strip())


# ---- images

def _image_gen(ex_id, card, alias, prompt, size, order=0, ext=None, title=None):
    @example(ex_id, "images", card)
    def _(c: Ctx):
        body = {"model": alias, "prompt": prompt, "size": size, "n": 1, "response_format": "b64_json"}
        if ext:
            body["extensions"] = {"com.azizam.workflow": ext}
        r, s = timed(lambda: c.gw.json("POST", "/v1/images/generations", json=body))
        png = b64_image(r)
        c.save({"id": ex_id, "card": card, "order": order, "title": title or f"Alias {alias}", "seconds": s, "model": alias, "resolves_to": c.gw.resolve("images", alias),
                "inputs": [{"kind": "text", "label": "Prompt", "name": "prompt", "value": prompt}],
                "outputs": [{"kind": "image", "file": "output.png"}]}, {"output.png": png})


_image_gen("image-krea2-turbo", "krea2-turbo", "image", SKY_PROMPT, "1024x1024", title="Stable alias image")
_image_gen("image-flux2-klein", "flux2-klein-4b", "image-fast", SKY_PROMPT, "1024x1024", title="Stable alias image-fast")
_image_gen("image-tile-flux2", "flux2-klein-4b-seamless-tile", "flux2-klein-4b-seamless-tile", "mossy cobblestone path texture, top-down, game asset, tileable", "1024x1024", title="Seamless tile")
_image_gen("image-tile-sdxl", "sdxl-seamless-tile", "sdxl-seamless-tile", "hand-painted wooden floor planks, top-down, game asset, tileable", "1024x1024", title="Seamless tile")


