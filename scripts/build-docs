#!/usr/bin/env python3
"""Render the product docs from Markdown to static HTML.

Sources live in ``showcase/docs-src``: ``nav.yml`` fixes the sections and page
order, and each page is a Markdown file with ``title`` and ``summary`` front
matter. Links between pages are relative ``.md`` links; the build rewrites
them to the served URLs under ``/showcase/docs/`` and fails when a link or
anchor does not resolve.

markdown-it-py and Pygments come from the locked dependency set
(tests/requirements-hermetic.lock); nothing new is installed.

Output goes to ``showcase/docs`` (one ``index.html`` per page, ``404.html`` and
``search-index.json``). The output is committed so the gateway serves it with
no build step at runtime. ``--check`` rebuilds in memory and exits 1 when the
committed output is stale.

Usage:
    scripts/build-docs            # write showcase/docs
    scripts/build-docs --check    # verify showcase/docs is current
"""

from __future__ import annotations

import argparse
import html
import json
import posixpath
import re
import shutil
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

import yaml
from markdown_it import MarkdownIt
from pygments import highlight as pygments_highlight
from pygments.formatters import HtmlFormatter
from pygments.lexers import get_lexer_by_name
from pygments.util import ClassNotFound

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "showcase" / "docs-src"
OUT = ROOT / "showcase" / "docs"
BASE = "/showcase/docs/"
STATIC = "/showcase/static/"

_LINK = re.compile(r'(href)="([^"]*)"')


class BuildError(Exception):
    pass


@dataclass
class Page:
    source: Path  # relative to SRC, e.g. "api/openai.md"
    section: str
    title: str
    summary: str
    body_md: str
    url: str = ""
    html: str = ""
    headings: list[tuple[int, str, str]] = field(default_factory=list)  # (level, id, text)
    text: str = ""


def page_url(source: str) -> str:
    """``index.md`` -> ``/showcase/docs/``; ``api/index.md`` -> ``.../api/``."""
    stem = source[:-3]
    if stem == "index":
        return BASE
    if stem.endswith("/index"):
        stem = stem[: -len("/index")]
    return f"{BASE}{stem}/"


def slugify(text: str) -> str:
    slug = re.sub(r"[^\w\s-]", "", text.lower()).strip()
    return re.sub(r"[\s_-]+", "-", slug) or "section"


def split_front_matter(raw: str, name: str) -> tuple[dict, str]:
    if not raw.startswith("---\n"):
        raise BuildError(f"{name}: missing front matter")
    end = raw.find("\n---\n", 4)
    if end < 0:
        raise BuildError(f"{name}: unterminated front matter")
    meta = yaml.safe_load(raw[4:end]) or {}
    for key in ("title", "summary"):
        if not isinstance(meta.get(key), str) or not meta[key].strip():
            raise BuildError(f"{name}: front matter needs '{key}'")
    return meta, raw[end + 5 :]


def load_pages() -> tuple[list[dict], list[Page]]:
    nav = yaml.safe_load((SRC / "nav.yml").read_text(encoding="utf-8"))
    sections, pages, seen = [], [], set()
    for section in nav["sections"]:
        entries = []
        for source in section["pages"]:
            if source in seen:
                raise BuildError(f"nav.yml lists {source} twice")
            seen.add(source)
            path = SRC / source
            if not path.is_file():
                raise BuildError(f"nav.yml lists missing page {source}")
            meta, body = split_front_matter(path.read_text(encoding="utf-8"), source)
            page = Page(Path(source), section["title"], meta["title"].strip(), meta["summary"].strip(), body)
            page.url = page_url(source)
            pages.append(page)
            entries.append(page)
        sections.append({"title": section["title"], "pages": entries})
    orphans = sorted(
        str(p.relative_to(SRC)) for p in SRC.rglob("*.md") if str(p.relative_to(SRC)) not in seen
    )
    if orphans:
        raise BuildError(f"pages not in nav.yml: {', '.join(orphans)}")
    return sections, pages


_FORMATTER = HtmlFormatter(nowrap=True)
_LANG_LABELS = {"sh": "Shell", "json": "JSON", "python": "Python", "yaml": "YAML", "text": "Text"}


def _highlight(code: str, lang: str, _attrs: str) -> str:
    if not lang or lang == "text":
        return ""
    try:
        lexer = get_lexer_by_name(lang)
    except ClassNotFound:
        raise BuildError(f"unknown code language '{lang}'") from None
    # Quotes need no escaping in element text, and Pygments releases differ on
    # whether they escape them; normalise so --check is stable across versions.
    out = pygments_highlight(code, lexer, _FORMATTER)
    return out.replace("&quot;", '"').replace("&#39;", "'").replace("&#x27;", "'")


def make_renderer() -> MarkdownIt:
    md = MarkdownIt("commonmark", {"highlight": _highlight}).enable("table")

    def heading_ids(state) -> None:
        used: dict[str, int] = {}
        tokens = state.tokens
        for i, token in enumerate(tokens):
            if token.type != "heading_open":
                continue
            text = "".join(
                child.content for child in (tokens[i + 1].children or []) if child.type in ("text", "code_inline")
            )
            slug = slugify(text)
            count = used.get(slug, 0)
            used[slug] = count + 1
            token.attrSet("id", slug if count == 0 else f"{slug}-{count}")
            token.meta["text"] = text

    md.core.ruler.push("heading_ids", heading_ids)

    def heading_open(self, tokens, idx, options, env):
        token = tokens[idx]
        env.setdefault("headings", []).append((int(token.tag[1]), token.attrGet("id"), token.meta["text"]))
        return self.renderToken(tokens, idx, options, env)

    def heading_close(self, tokens, idx, options, env):
        token = tokens[idx]
        if token.tag in ("h2", "h3"):
            hid = tokens[idx - 2].attrGet("id")
            text = tokens[idx - 2].meta["text"]
            anchor = (
                f' <a class="anchor" href="#{hid}" aria-label="Link to {html.escape(text, quote=True)}">#</a>'
            )
            return anchor + f"</{token.tag}>\n"
        return f"</{token.tag}>\n"

    def table_open(self, tokens, idx, options, env):
        return '<div class="table-wrap" tabindex="0" role="region" aria-label="Table">\n<table>\n'

    def table_close(self, tokens, idx, options, env):
        return "</table>\n</div>\n"

    def fence(self, tokens, idx, options, env):
        token = tokens[idx]
        lang = token.info.strip().split()[0] if token.info.strip() else ""
        body = _highlight(token.content, lang, "") or html.escape(token.content)
        label = _LANG_LABELS.get(lang, "")
        return (
            '<div class="codeblock">'
            f'<div class="code-bar"><span class="code-lang">{label}</span>'
            '<button class="copy js-only" type="button">Copy</button></div>'
            f"<pre><code>{body}</code></pre></div>\n"
        )

    md.add_render_rule("heading_open", heading_open)
    md.add_render_rule("heading_close", heading_close)
    md.add_render_rule("table_open", table_open)
    md.add_render_rule("table_close", table_close)
    md.add_render_rule("fence", fence)
    return md


def resolve_links(page: Page, by_source: dict[str, Page]) -> None:
    """Rewrite relative ``.md`` links to served URLs; check pages and anchors."""

    def fix(match: re.Match) -> str:
        attr, href = match.group(1), html.unescape(match.group(2))
        if href.startswith(("http://", "https://")):
            if "github.com" in href:
                raise BuildError(f"{page.source}: links to github.com ({href})")
            return match.group(0)
        if href.startswith(("mailto:", "/")) or not href:
            return match.group(0)
        target, _, anchor = href.partition("#")
        if not target:
            if anchor not in {h[1] for h in page.headings}:
                raise BuildError(f"{page.source}: missing anchor #{anchor}")
            return match.group(0)
        if not target.endswith(".md"):
            raise BuildError(f"{page.source}: relative link must target a .md page ({href})")
        resolved = posixpath.normpath(posixpath.join(posixpath.dirname(str(page.source)), target))
        other = by_source.get(resolved)
        if other is None:
            raise BuildError(f"{page.source}: link to missing page {href}")
        if anchor and anchor not in {h[1] for h in other.headings}:
            raise BuildError(f"{page.source}: missing anchor {href}")
        url = other.url + (f"#{anchor}" if anchor else "")
        return f'{attr}="{html.escape(url, quote=True)}"'

    page.html = _LINK.sub(fix, page.html)


_TAGS = re.compile(r"<[^>]+>")


def plain_text(rendered: str) -> str:
    text = re.sub(r'<a class="anchor"[^>]*>#</a>', "", rendered)
    text = re.sub(r"<h1[^>]*>.*?</h1>", "", text, flags=re.S)
    text = re.sub(r"</h[2-6]>", " · ", text)
    text = re.sub(r"</(p|li|td|th|pre|div)>", " ", text)
    text = html.unescape(_TAGS.sub("", text))
    return re.sub(r"\s+", " ", text).strip()


def nav_html(sections: list[dict], current: Page | None) -> str:
    parts = []
    for section in sections:
        items = []
        for p in section["pages"]:
            here = current is not None and p.url == current.url
            aria = ' aria-current="page"' if here else ""
            items.append(f'<li><a href="{p.url}"{aria}>{html.escape(p.title)}</a></li>')
        parts.append(
            f'<li class="nav-section"><p class="nav-heading">{html.escape(section["title"])}</p>'
            f'<ul>{"".join(items)}</ul></li>'
        )
    return f'<ul class="nav-list">{"".join(parts)}</ul>'


def toc_html(page: Page) -> str:
    items = [
        f'<li class="toc-l{level}"><a href="#{hid}">{html.escape(text)}</a></li>'
        for level, hid, text in page.headings
        if level in (2, 3)
    ]
    return f'<ul>{"".join(items)}</ul>' if len(items) >= 2 else ""


def site_chrome() -> tuple[str, str]:
    """Reuse Home chrome; native mobile disclosure needs no site.js."""
    home = (ROOT / "showcase" / "index.html").read_text(encoding="utf-8")
    header_match = re.search(r'<header class="site-header">.*?</header>', home, re.S)
    footer_match = re.search(r'<footer class="foot">.*?</footer>', home, re.S)
    if not header_match or not footer_match:
        raise BuildError("Home must supply the shared site header and footer")
    header = header_match.group().replace(' aria-current="page"', "")
    header = header.replace('href="/showcase/docs/"', 'href="/showcase/docs/" aria-current="page"')
    header = re.sub(r'  <button class="site-menu"[^>]*>Menu</button>\n', "", header)
    nav = re.search(r'<nav id="site-nav".*?</nav>', header, re.S)
    if not nav:
        raise BuildError("Home must supply the Site navigation")
    mobile_nav = nav.group().replace(' id="site-nav"', "")
    disclosure = (
        '  <details class="site-disclosure">\n'
        '    <summary>Menu</summary>\n'
        f'    {mobile_nav}\n'
        '  </details>\n'
    )
    return header.replace("</header>", disclosure + "</header>"), footer_match.group()


def layout(*, title: str, description: str, nav: str, main: str, canonical: str, here: str) -> str:
    header, footer = site_chrome()
    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{html.escape(title)}</title>
<meta name="description" content="{html.escape(description, quote=True)}">
<link rel="stylesheet" href="{STATIC}showcase.css">
<link rel="stylesheet" href="{STATIC}docs.css">
<script src="{STATIC}docs.js" defer></script>
<noscript><style>.js-only {{ display: none !important; }}</style></noscript>
</head>
<body class="docs" data-page="{html.escape(canonical, quote=True)}">
<a class="skip-link" href="#content">Skip to content</a>
{header}
<div class="docs-toolbar">
  <div class="docs-top-inner">
    <div class="docs-top-actions">
      <button class="search-open js-only" type="button" aria-label="Search the docs" aria-haspopup="dialog" aria-controls="search">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span>Search</span><kbd aria-hidden="true">/</kbd>
      </button>
      <a class="api-link" href="/openapi.json">API reference</a>
    </div>
  </div>
</div>
<details class="docs-menu">
  <summary><span class="docs-menu-label">Documentation</span> <span class="docs-menu-here">{html.escape(here)}</span></summary>
  <nav aria-label="Documentation (menu)">{nav}</nav>
</details>
<div class="docs-shell">
  <nav class="docs-nav" aria-label="Documentation">
    {nav}
  </nav>
  {main}
</div>
{footer}
<dialog id="search" class="search" aria-labelledby="search-title">
  <form method="dialog" class="search-form" role="search">
    <h2 id="search-title" class="visually-hidden">Search the docs</h2>
    <label class="visually-hidden" for="search-input">Search the docs</label>
    <input id="search-input" type="search" placeholder="Search the docs" autocomplete="off" spellcheck="false" aria-describedby="search-count" aria-controls="search-results">
    <button class="search-close" type="submit" value="close">Close</button>
  </form>
  <p id="search-count" class="search-count" role="status" aria-live="polite"></p>
  <ul id="search-results" class="search-results"></ul>
</dialog>
<p id="copy-status" class="visually-hidden" role="status" aria-live="polite"></p>
</body>
</html>
"""


def render_page(page: Page, sections: list[dict], prev: Page | None, nxt: Page | None) -> str:
    toc = toc_html(page)
    toc_block = ""
    if toc:
        toc_block = (
            f'<details class="toc-inline"><summary>On this page</summary><nav aria-label="On this page (inline)">{toc}</nav></details>'
        )
    aside = f'<aside class="toc"><nav aria-label="On this page"><p class="toc-title">On this page</p>{toc}</nav></aside>' if toc else ""
    body = page.html
    if toc_block:
        # Place the phone "On this page" list after the opening paragraph.
        at = body.find("</p>\n", body.find("</h1>"))
        at = at + len("</p>\n") if at >= 0 else body.find("</h1>\n") + len("</h1>\n")
        body = body[:at] + toc_block + body[at:]
    pager = []
    if prev:
        pager.append(
            f'<a class="pager-prev" href="{prev.url}" rel="prev"><span>Previous</span>{html.escape(prev.title)}</a>'
        )
    if nxt:
        pager.append(f'<a class="pager-next" href="{nxt.url}" rel="next"><span>Next</span>{html.escape(nxt.title)}</a>')
    pager_html = f'<nav class="pager" aria-label="Previous and next page">{"".join(pager)}</nav>' if pager else ""
    main = f"""<main id="content" class="docs-main" tabindex="-1">
    <article class="prose">
      <p class="eyebrow">{html.escape(page.section)}</p>
      {body}
    </article>
    {pager_html}
  </main>
  {aside}"""
    title = f"{page.title} · Azizam docs" if page.url != BASE else "Azizam docs"
    return layout(title=title, description=page.summary, nav=nav_html(sections, page), main=main, canonical=page.url, here=page.title)


def render_404(sections: list[dict]) -> str:
    main = f"""<main id="content" class="docs-main" tabindex="-1">
    <article class="prose">
      <h1>Page not found</h1>
      <p>This docs page does not exist. It may have moved.</p>
      <p><a href="{BASE}">Go to the docs home</a>, or use Search.</p>
    </article>
  </main>"""
    return layout(title="Page not found · Azizam docs", description="Page not found.", nav=nav_html(sections, None), main=main, canonical=BASE + "404", here="Page not found")


def build() -> dict[str, bytes]:
    sections, pages = load_pages()
    md = make_renderer()
    for page in pages:
        env: dict = {}
        page.html = md.render(page.body_md, env)
        page.headings = env.get("headings", [])
        h1 = [h for h in page.headings if h[0] == 1]
        if len(h1) != 1 or h1[0][2] != page.title:
            raise BuildError(f"{page.source}: needs exactly one '# {page.title}' heading")
    by_source = {str(p.source): p for p in pages}
    for page in pages:
        resolve_links(page, by_source)
        page.text = plain_text(page.html)

    files: dict[str, bytes] = {}
    for i, page in enumerate(pages):
        prev = pages[i - 1] if i > 0 else None
        nxt = pages[i + 1] if i + 1 < len(pages) else None
        rel = page.url[len(BASE) :] + "index.html"
        files[rel] = render_page(page, sections, prev, nxt).encode()
    files["404.html"] = render_404(sections).encode()
    index = [
        {
            "url": p.url,
            "title": p.title,
            "section": p.section,
            "summary": p.summary,
            "headings": [{"id": hid, "text": text} for level, hid, text in p.headings if level in (2, 3)],
            "text": p.text,
        }
        for p in pages
    ]
    files["search-index.json"] = (json.dumps(index, ensure_ascii=False, separators=(",", ":")) + "\n").encode()
    return files


def current_files() -> dict[str, bytes]:
    if not OUT.is_dir():
        return {}
    return {str(p.relative_to(OUT)): p.read_bytes() for p in OUT.rglob("*") if p.is_file()}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true", help="exit 1 if showcase/docs is stale")
    args = parser.parse_args()
    try:
        files = build()
    except BuildError as exc:
        print(f"build-docs: {exc}", file=sys.stderr)
        return 2
    if args.check:
        if files != current_files():
            print("build-docs: showcase/docs is stale; run scripts/build-docs", file=sys.stderr)
            return 1
        print(f"build-docs: {len(files)} files current")
        return 0
    staging = Path(tempfile.mkdtemp(prefix=".docs-", dir=OUT.parent))
    try:
        for rel, data in files.items():
            path = staging / rel
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
        if OUT.exists():
            shutil.rmtree(OUT)
        staging.rename(OUT)
    finally:
        if staging.exists():
            shutil.rmtree(staging)
    print(f"build-docs: wrote {len(files)} files to {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
