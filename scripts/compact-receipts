#!/usr/bin/env python3
"""Owner-triggered receipt compaction, outside all gateway request paths."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from gateway import receipt_store

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--db", type=Path, required=True, help="Receipt database to compact; allow temporary space for the rebuild")
args = parser.parse_args()
result = receipt_store.compact(args.db)
print(json.dumps(result))
if result["checkpoint_pending"]:
    print("WAL checkpoint pending: retry when database readers are idle.", file=sys.stderr)
    sys.exit(1)
