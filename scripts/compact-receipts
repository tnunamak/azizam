#!/usr/bin/env python3
"""Owner-triggered receipt compaction, outside all gateway request paths."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from gateway import receipt_store

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--db", type=Path, required=True, help="Receipt database to compact; allow temporary space for the rebuild")
args = parser.parse_args()
print(json.dumps(receipt_store.compact(args.db)))
